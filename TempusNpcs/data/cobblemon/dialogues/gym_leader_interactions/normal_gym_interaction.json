{
    "initializationAction": [
        "q.player.data.normal_gym_defeated ? q.dialogue.set_page('post_defeat');"
    ],
    "speakers": {
        "npc": {
            "name": {
                "type": "expression",
                "expression": "q.npc.name"
            },
            "face": "q.npc.face();"
        },
        "player": {
            "face": "q.player.face();",
            "name": {
                "type": "expression",
                "expression": "q.player.username"
            }
        }
    },
    "pages": [
        {
            "id": "reject",
            "speaker": "npc",
            "lines": [
                "Listen I'm trying to get my doctorate and I'm working on my dissertation. I'm not going to waste my time fighting third rates."
            ],
            "input": "q.dialogue.set_page('reject_2');"
        },
        {
            "id": "reject_2",
            "speaker": "npc",
            "lines": [
                "Once you beat the others in the library, I'll hear you out."
            ],
            "input": "q.dialogue.close();"
        },
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                "Can't be interrupted for 5 minutes... Fine I'll do my job."
            ],
            "input": [
                "q.npc.play_animation('thinking', q.player.uuid);",
                "q.dialogue.set_page('battle_prompt');"
            ]
        },
        {
            "id": "battle_prompt",
            "speaker": "npc",
            "lines": [
                "I'm Reid, temporary Gym Leader of La Relance, I wanna get this over with as soon as possible."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "§c⚔ Battle ⚔§r",
                        "value": "battle",
                        "isSelectable": "q.player.data.normal_gym_defeated == false",
                        "action": [
                            "q.npc.play_animation('thinking', q.player.uuid);",
                            "q.dialogue.set_page('battle_start');"
                        ]
                    },
                    {
                        "text": "No",
                        "value": "no",
                        "action": "q.dialogue.close();"
                    }
                ]
            }
        },
        {
            "id": "battle_start",
            "speaker": "npc",
            "lines": [
                "Okay, I guess beating you up should count as my study break."
            ],
            "escapeAction": "0",
            "input": [
                "q.dialogue.close();",
                "v.battle = q.npc.start_battle(q.player);"
            ]
        },
        {
            "id": "post_defeat",
            "speaker": "npc",
            "lines": [
                "Sorry for being an asshole earlier, you're strong, but don't stop learning."
            ],
            "input": "q.dialogue.close();"
        }
    ]
}