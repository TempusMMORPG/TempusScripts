{
    "initializationAction": [
        "q.player.data.flying_gym_defeated ? q.dialogue.set_page('post_defeat');",
        "q.player.data.flying_trainer_defeat_count >= 4 ? q.dialogue.set_page('greeting');"
    ],
    "speakers": {
        "npc": {
            "name": {
                "type": "expression",
                "expression": "q.npc.name"
            },
            "face": "q.npc.face();"
        },
        "player": {
            "face": "q.player.face();",
            "name": {
                "type": "expression",
                "expression": "q.player.username"
            }
        }
    },
    "pages": [
        {
            "id": "reject",
            "speaker": "npc",
            "lines": [
                "Hey there! You're here to fight me right? The special thing about this flight is the in-flight entertainment is live battles!"
            ],
            "input": "q.dialogue.set_page('reject_2');"
        },
        {
            "id": "reject_2",
            "speaker": "npc",
            "lines": [
                "Fight the Flight Attendants first so the other passengers get their money's worth."
            ],
            "input": "q.dialogue.close();"
        },
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                "Nice battling trainer! I could here the cheers from economy class all the way up here!"
            ],
            "input": [
                "q.npc.play_animation('chatting', q.player.uuid);",
                "q.dialogue.set_page('greeting2');"
            ]
        },
        {
            "id": "greeting2",
            "speaker": "npc",
            "lines": [
                "I'm Capt. Atlas, the pilot of this flight and the proud Gym Leader for Unity City."
            ],
            "input": [
                "q.npc.play_animation('thinking', q.player.uuid);",
                "q.dialogue.set_page('battle_prompt');"
            ]
        },
        {
            "id": "battle_prompt",
            "speaker": "npc",
            "lines": [
                "Do you think you have what it takes to match a veteran of the Venola Air Force?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "§c⚔ Battle ⚔§r",
                        "value": "battle",
                        "isSelectable": "q.player.data.flying_gym_defeated == false",
                        "action": [
                            "q.npc.play_animation('salute', q.player.uuid);",
                            "q.dialogue.set_page('battle_start');"
                        ]
                    },
                    {
                        "text": "No",
                        "value": "no",
                        "action": "q.dialogue.close();"
                    }
                ]
            }
        },
        {
            "id": "battle_start",
            "speaker": "npc",
            "lines": [
                "Well then, be careful to not get shot down!"
            ],
            "escapeAction": "0",
            "input": [
                "q.dialogue.close();",
                "v.battle = q.npc.start_battle(q.player);"
            ]
        },
        {
            "id": "post_defeat",
            "speaker": "npc",
            "lines": [
                "Back for another flight, huh? I'll gladly chat about strategy, but remember, you've already bested me. I appreciate the thought nevertheless."
            ],
            "input": "q.dialogue.close();"
        }
    ]
}