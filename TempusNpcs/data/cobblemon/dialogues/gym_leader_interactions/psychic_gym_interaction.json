{
    "initializationAction": [
        "q.player.data.psychic_gym_defeated ? q.dialogue.set_page('post_defeat');",
        "q.player.data.psychic_trainer_defeat_count >= 4 ? q.dialogue.set_page('greeting');"
    ],
    "speakers": {
        "npc": {
            "name": {
                "type": "expression",
                "expression": "q.npc.name"
            },
            "face": "q.npc.face();"
        },
        "player": {
            "face": "q.player.face();",
            "name": {
                "type": "expression",
                "expression": "q.player.username"
            }
        }
    },
    "pages": [
        {
            "id": "reject",
            "speaker": "npc",
            "lines": [
                "I'm busy. Don't talk to me unless absolutely necessary."
            ],
            "input": "q.dialogue.close();"
        },
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                "Great a challenger, the reason why I'm missing out on the greatest thing to happen to this region."
            ],
            "input": [
                "q.npc.play_animation('chatting', q.player.uuid);",
                "q.dialogue.set_page('greeting2');"
            ]
        },
        {
            "id": "greeting2",
            "speaker": "npc",
            "lines": [
                "I'm Cassie, leader of the Dell Village Gym blah blah blah let's get this over with."
            ],
            "input": [
                "q.npc.play_animation('thinking', q.player.uuid);",
                "q.dialogue.set_page('battle_prompt');"
            ]
        },
        {
            "id": "battle_prompt",
            "speaker": "npc",
            "lines": [
                "Sooner this day is done with, sooner I can go to the crash site. Don't waste my time any longer."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "§c⚔ Battle ⚔§r",
                        "value": "battle",
                        "isSelectable": "q.player.data.psychic_gym_defeated == false",
                        "action": [
                            "q.npc.play_animation('salute', q.player.uuid);",
                            "q.dialogue.set_page('battle_start');"
                        ]
                    },
                    {
                        "text": "No",
                        "value": "no",
                        "action": "q.dialogue.close();"
                    }
                ]
            }
        },
        {
            "id": "battle_start",
            "speaker": "npc",
            "lines": [
                "Time to vent my frustrations on you."
            ],
            "escapeAction": "0",
            "input": [
                "q.dialogue.close();",
                "v.battle = q.npc.start_battle(q.player);"
            ]
        },
        {
            "id": "post_defeat",
            "speaker": "npc",
            "lines": [
                "I have better things to do than talk to you. Leave."
            ],
            "input": "q.dialogue.close();"
        }
    ]
}