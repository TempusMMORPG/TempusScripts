{
    "initializationAction": [
        "q.npc.config.toggle_battle_cooldown && q.run_script('cobblemon:cooldown_check') ? q.dialogue.set_page('completed');"
    ],
    "speakers": {
        "npc": {
            "name": {
                "type": "expression",
                "expression": "q.npc.name"
            },
            "face": "q.npc.face();",
            "gibber": {
                "interval": 0.1
            }
        },
        "player": {
            "face": "q.player.face();",
            "gibber": {
                "interval": 0.1
            },
            "name": {
                "type": "expression",
                "expression": "q.player.username"
            }
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                "Hello there! I could really use some help with a little job if you're up for it.",
                {
                    "type": "expression",
                    "expression": "'I need someone to bring me §d' + q.run_script('cobblemon:penelopes_plants_giver') + '§r!'"
                }
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "§a✉ Accept Job ✉§r",
                        "value": "accept",
                        "action": [
                            "q.player.set_npc_variable(q.npc.uuid, 'in_progress', 1);",
                            "q.dialogue.set_page('in_progress');"
                        ]
                    },
                    {
                        "text": "Sorry, not right now.",
                        "value": "no",
                        "action": "q.dialogue.close();"
                    }
                ]
            }
        },
        {
            "id": "in_progress",
            "speaker": "npc",
            "lines": ["How's the job coming along? Do you have the items for me?"],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "§aSubmit Items§r",
                        "value": "submit",
                        "isSelectable": "q.player.main_held_item.is_of(q.npc.config.consume_item) || q.player.off_held_item.is_of(q.npc.config.consume_item)",
                        "action": "q.run_script('cobblemon:penelopes_plants_submit') == 1 ? q.dialogue.set_page('completed') : q.dialogue.close();"
                    },
                    {
                        "text": "§6What's the job again?§r",
                        "value": "reminder",
                        "action": "q.dialogue.set_page('reminder');"
                    },
                    {
                        "text": "I'm still working on it.",
                        "value": "no",
                        "action": "q.dialogue.close();"
                    }
                ]
            }
        },
        {
            "id": "reminder",
            "speaker": "npc",
            "lines": [
                "Let me check my notes...",
                {
                    "type": "expression",
                    "expression": "t.amt = q.player.get_npc_variable(q.npc.uuid, 'quest_item_amount'); t.id = q.player.get_npc_variable(q.npc.uuid, 'quest_item_id'); t.name = q.split_string(t.id, ':')[1]; 'I need you to bring me §d' + t.amt + ' ' + t.name + '§r. Thanks for the help!'"
                }
            ],
            "input": {
                "type": "option",
                "options": [{"text": "Got it, thanks!", "value": "back", "action": "q.dialogue.set_page('in_progress');"}]
            }
        },
        {
            "id": "completed",
            "speaker": "npc",
            "lines": [
                "You've already helped me out today. Thanks again!",
                "I'll have another job for you in:",
                        {
                    "type": "expression",
                    "expression": "'§8§o' + q.run_script('cobblemon:cooldown_remaining_time');"
                }
            ],
            "input": {
                "type": "option",
                "options": [{"text": "Goodbye", "value": "bye", "action": "q.dialogue.close();"}]
            }
        }
    ]
}