{
    "speakers": {
        "npc": {
            "name": {
                "type": "expression",
                "expression": "q.npc.name"
            },
            "face": "q.npc.face();"
        },
        "player": {
            "face": "q.player.face();",
            "name": {
                "type": "expression",
                "expression": "q.player.username"
            }
        }
    },
    "pages": [
        {
            "id": "portal_active",
            "speaker": "npc",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'Power courses through the ancient portal as it opens. Would you like to enter? ';"
                }
            ],
            "textColor": "FFFFFF",
            "background": "cobblemon:textures/gui/dialogue/dialogue_box_info.png",
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": {
                            "type": "expression",
                            "expression": "'Enter the Rift'"
                        },
                        "value": "teleport",
                        "isSelectable": "q.npc.config.is_portal_active == true",
                        "action": [
                            "q.run_command('title ' + q.player.username + ' times 0 10 20');",
                            "q.run_command('title ' + q.player.username + ' title {\"text\":\"a\",\"font\":\"filter:fill\",\"color\":\"#000000\"}');",
                            "q.run_command('mw tp ' + q.npc.config.portal_world + ' ' + q.player.username);",
                            "q.dialogue.close();",
                        ]
                    },
                    {
                        "text": "Exit",
                        "value": "exit",
                        "action": "q.dialogue.close();"
                    }
                ]
            }
        }
    ]
}