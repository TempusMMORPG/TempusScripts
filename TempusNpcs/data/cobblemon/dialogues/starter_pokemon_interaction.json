            "lines": [
                {
                    "type": "expression",
                    "expression": "'§oThe ' + q.npc.config.starter_name_display + ' looks at you curiously.§r';"
                }
            ],
            "textColor": "FFFFFF",
            "background": "cobblemon:textures/gui/dialogue/dialogue_box_info.png",
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "§aAdopt this Pokemon?",
                        "value": "yes",
                        "isVisible": "q.player.party.count() == 0 && q.player.data.dialogue.starter_selected == 0;",
                        "action": "q.dialogue.set_page('confirmation');"
                    },
                    {
                        "text": "§6Pet",
                        "value": "pet",
                        "action": [
