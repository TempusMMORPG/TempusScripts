{
"initializationAction": [
        "q.npc.config.starter_name == 'mankey' ? q.dialogue.set_page('mankey_intro');",
        "q.npc.config.starter_name == 'lillipup' ? q.dialogue.set_page('lillipup_intro');",
        "q.npc.config.starter_name == 'eevee' ? q.dialogue.set_page('eevee_intro');",
        "q.npc.config.starter_name == 'froakie' ? q.dialogue.set_page('froakie_intro');",
        "q.npc.config.starter_name == 'sandile' ? q.dialogue.set_page('sandile_intro');"

    ],
    "speakers": {
        "npc": {
            "name": {
                "type": "expression",
                "expression": "q.npc.name"
            },
            "face": "q.npc.face();",
            "gibber": {
                "interval": 0.1
            }
        },
        "player": {
            "face": "q.player.face();",
            "name": {
                "type": "expression",
                "expression": "q.player.username"
            },
            "gibber": {
                "interval": 0.1
            }
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'§oThe ' + q.npc.config.starter_name_display + ' looks at you curiously.§r';"
                }
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "§aAdopt this Pokemon?",
                        "value": "yes",
                        "isVisible": "q.player.party.count() == 0 && q.player.data.dialogue.starter_selected == 0;",
                        "action": "q.dialogue.set_page('confirmation');"
                    },
                    {
                        "text": "§6Pet",
                        "value": "pet",
                        "action": [
                            "q.npc.play_animation('cry');",
                            "q.dialogue.close();"
                        ]
                    }
                ]
            }
        },
        {
