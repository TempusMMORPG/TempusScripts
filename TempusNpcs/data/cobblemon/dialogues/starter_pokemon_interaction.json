{
"initializationAction": [
        "q.npc.play_animation('cry', q.player.username);",
        "q.npc.config.starter_name == 'mankey' ? q.dialogue.set_page('mankey_intro');",
        "q.npc.config.starter_name == 'lillipup' ? q.dialogue.set_page('lillipup_intro');",
        "q.npc.config.starter_name == 'eevee' ? q.dialogue.set_page('eevee_intro');",
        "q.npc.config.starter_name == 'froakie' ? q.dialogue.set_page('froakie_intro');",
        "q.npc.config.starter_name == 'sandile' ? q.dialogue.set_page('sandile_intro');",
        "q.npc.config.starter_name == 'squirtle' ? q.dialogue.set_page('squritle_intro');",
        "q.npc.config.starter_name == 'pikachu' ? q.dialogue.set_page('pikachu_intro');",
        "q.npc.config.starter_name == 'chikorita' ? q.dialogue.set_page('chikorita_intro');",
        "q.npc.config.starter_name == 'scorbunny' ? q.dialogue.set_page('scorbunny_intro');",
        "q.npc.config.starter_name == 'spheal' ? q.dialogue.set_page('spheal_intro');",
        "q.npc.config.starter_name == 'snivy' ? q.dialogue.set_page('snivy_intro');",
        "q.npc.config.starter_name == 'venipede' ? q.dialogue.set_page('venipede_intro');",
        "q.npc.config.starter_name == 'chimchar' ? q.dialogue.set_page('chimchar_intro');",
        "q.npc.config.starter_name == 'grookey' ? q.dialogue.set_page('grookey_intro');",
        "q.npc.config.starter_name == 'rolycoly' ? q.dialogue.set_page('rolycoly_intro');",
        "q.npc.config.starter_name == 'zubat' ? q.dialogue.set_page('zubat_intro');"

    ],
    "speakers": {
        "npc": {
            "name": {
                "type": "expression",
                "expression": "q.npc.name"
            },
            "face": "q.npc.face();",
            "gibber": {
                "interval": 0.1
            }
        },
        "player": {
            "face": "q.player.face();",
            "name": {
                "type": "expression",
                "expression": "q.player.username"
            },
            "gibber": {
                "interval": 0.1
            }
        }
    },
