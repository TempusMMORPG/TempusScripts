            "id": "confirmation",
            "speaker": "npc",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'§oAre you sure you would like ' + q.npc.config.starter_name_display + ' as your starter Pokemon? (This action cannot be undone).§r';"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "§a Choose Starter§r",
                        "value": "scan",
                        "action": [
                            "q.run_script('starter_pokemon');",
                            "q.player.data.dialogue.starter_selected = true; q.player.save_data();",
                            "q.dialogue.close();"
                        ]
                    },
                    {
                        "text": "No",
                        "value": "no",
                        "action": "q.dialogue.set_page('okbye');"
                    }
                ]
            }
        },
        {
            "id": "okbye",
            "speaker": "player",
            "lines": [
                "§oI think I should leave this Pokemon alone...§r"
            ],
            "input": "q.dialogue.close();"
