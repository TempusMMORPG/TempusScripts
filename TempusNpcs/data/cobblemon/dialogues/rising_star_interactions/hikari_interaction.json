{
    "initializationAction": [
        "!q.player.data.hikari_defeated_1 ? q.dialogue.set_page('interact1');",
        "q.player.data.hikari_defeated_1 && !q.player.data.hikari_defeated_2 ? q.dialogue.set_page('interact2');",
        "q.player.data.hikari_defeated_2 && !q.player.data.hikari_defeated_3 ? q.dialogue.set_page('interact3');",
        "q.player.data.hikari_defeated_3 && !q.player.data.hikari_defeated_4 ? q.dialogue.set_page('interact4');",
        "q.player.data.hikari_defeated_4 && q.player.data.e4_champion_defeated ? q.dialogue.set_page('interact5');"
    ],
    "speakers": {
        "npc": {
            "name": {
                "type": "expression",
                "expression": "q.npc.name"
            },
            "face": "q.npc.face();",
            "gibber": {
                "interval": 0.1
            }
        },
        "player": {
            "face": "q.player.face();",
            "gibber": {
                "interval": 0.1
            },
            "name": {
                "type": "expression",
                "expression": "q.player.username"
            }
        }
    },
    "pages": [
        {
            "id": "post_defeat",
            "speaker": "npc",
            "lines": [
                "Nothing beats the thrill of a long journey and a good battle, right?"
            ],
            "input": "q.dialogue.close();"
        },
        {
            "id": "interact1",
            "speaker": "npc",
            "lines": [
                "Whoa there! Who are you!? You're one of those Yakuzas, aren't you?"
            ],
            "input": [
                "q.dialogue.set_page('a1');"
            ]
        },
        {
            "id": "a1",
            "speaker": "npc",
            "lines": [
                "Hehe, just messing with you. Don't worry, I'm not here to cause trouble!"
            ],
            "input": [
                "q.dialogue.set_page('a2');",
                "q.npc.play_animation('shrug', q.player.uuid);"
            ]
        },
        {
            "id": "a2",
            "speaker": "npc",
            "lines": [
                "The name is Hikari! I'm on the hunt for the most exciting battles in the region."
            ],
            "input": [
                "q.dialogue.set_page('a3');"
            ]
        },
        {
            "id": "a3",
            "speaker": "npc",
            "lines": [
                "Say, you look like you have some spark in you, and a team to match..."
            ],
            "input": [
                "q.dialogue.set_page('battle_prompt_a');",
                "q.npc.play_animation('thinking', q.player.uuid);"
            ]
        },
        {
            "id": "battle_prompt_a",
            "speaker": "npc",
            "lines": [
                "Say, how about a quick battle? Come on! I don't bite... much."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "§c⚔ Battle ⚔§r",
                        "value": "battle",
                        "action": [
                            "q.dialogue.set_page('battle_start_a');",
                            "q.npc.play_animation('laugh', q.player.uuid);"
                        ]
                    },
                    {
                        "text": "No",
                        "value": "no",
                        "action": "q.dialogue.close();"
                    }
                ]
            }
        },
        {
            "id": "battle_start_a",
            "speaker": "npc",
            "lines": [
                "Hehe, this is gonna be exhilarating!"
            ],
            "escapeAction": "0",
            "input": [
                "q.dialogue.close();",
                "v.battle = q.npc.start_battle(q.player);"
            ]
        },
        {
            "id": "interact2",
            "speaker": "npc",
            "lines": [
                "Oh, well if it isn't my favorite trainer! Have you taken a look around Umigawa? It's such a beautiful place!"
            ],
            "input": [
                "q.dialogue.set_page('b1');"
            ]
        },
        {
            "id": "b1",
            "speaker": "npc",
            "lines": [
                "I bet you've seen even more amazing sights while traveling around the region, huh?"
            ],
            "input": [
                "q.dialogue.set_page('b2');",
                "q.npc.play_animation('shrug', q.player.uuid);"
            ]
        },
        {
            "id": "b2",
            "speaker": "npc",
            "lines": [
                "I've been exploring and battling a lot too, and I think I've come up with a new battle strategy!"
            ],
            "input": [
                "q.dialogue.set_page('b3');"
            ]
        },
        {
            "id": "b3",
            "speaker": "npc",
            "lines": [
                "I call it 'chaos'. It's all about keeping my opponent guessing (Crap, I knew I needed a better name...)."
            ],
            "input": [
                "q.dialogue.set_page('battle_prompt_b');"
            ]
        },
        {
            "id": "battle_prompt_b",
            "speaker": "npc",
            "lines": [
                "Anyway, I bet your itching for a rematch, right?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "§c⚔ Battle ⚔§r",
                        "value": "battle",
                        "action": [
                            "q.dialogue.set_page('battle_start_b');",
                            "q.npc.play_animation('laugh', q.player.uuid);"
                        ]
                    },
                    {
                        "text": "No",
                        "value": "no",
                        "action": "q.dialogue.close();"
                    }
                ]
            }
        },
        {
            "id": "battle_start_b",
            "speaker": "npc",
            "lines": [
                "Haha! Awesome! Let's see what you've got!"
            ],
            "escapeAction": "0",
            "input": [
                "q.dialogue.close();",
                "v.battle = q.npc.start_battle(q.player);"
            ]
        },
        {
            "id": "interact3",
            "speaker": "npc",
            "lines": [
                "...Oh, it's you again, trainer."
            ],
            "input": [
                "q.dialogue.set_page('c1');"
            ]
        },
        {
            "id": "c1",
            "speaker": "npc",
            "lines": [
                "I've just been... trying for so long now. But our last mach... feels different."
            ],
            "input": [
                "q.dialogue.set_page('c2');"
            ]
        },
        {
            "id": "c2",
            "speaker": "npc",
            "lines": [
                "Ever time we battle, I lose. No matter how I train, or what I do, I just can't seem to beat you."
            ],
            "input": [
                "q.dialogue.set_page('c3');"
            ]
        },
        {
            "id": "c3",
            "speaker": "npc",
            "lines": [
                "Am I doing something wrong...? Why do I feel so helpless...? Why can't I understand...?"
            ],
            "input": [
                "q.dialogue.set_page('c4');"
            ]
        },
        {
            "id": "c4",
            "speaker": "npc",
            "lines": [
                "...Sorry, I'm just... a bit frustrated, I guess."
            ],
            "input": [
                "q.dialogue.set_page('c5');"
            ]
        },
        {
            "id": "c5",
            "speaker": "npc",
            "lines": [
                "I know I'm missing something, but I know this isn't the way to go about it."
            ],
            "input": [
                "q.dialogue.set_page('c6');"
            ]
        },
        {
            "id": "c6",
            "speaker": "npc",
            "lines": [
                "Yeah! I can't quit now! This is my path, and I must see it through!"
            ],
            "input": [
                "q.dialogue.set_page('battle_prompt_c');"
            ]
        },
        {
            "id": "battle_prompt_c",
            "speaker": "npc",
            "lines": [
                "Trainer, please... battle me once more!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "§c⚔ Battle ⚔§r",
                        "value": "battle",
                        "action": [
                            "q.dialogue.set_page('battle_start_c');"
                        ]
                    },
                    {
                        "text": "No",
                        "value": "no",
                        "action": "q.dialogue.close();"
                    }
                ]
            }
        },
        {
            "id": "battle_start_c",
            "speaker": "npc",
            "lines": [
                "I'll show you our passion can get through this!"
            ],
            "escapeAction": "0",
            "input": [
                "q.dialogue.close();",
                "v.battle = q.npc.start_battle(q.player);"
            ]
        },
        {
            "id": "interact4",
            "speaker": "npc",
            "lines": [
                "Hey trainer, I... I've been doing a lot of thinking since our last battle."
            ],
            "input": [
                "q.dialogue.set_page('d1');"
            ]
        },
        {
            "id": "d1",
            "speaker": "npc",
            "lines": [
                "I realized that I... Didn't really understand the basics of being a trainer."
            ],
            "input": [
                "q.dialogue.set_page('d2');"
            ]
        },
        {
            "id": "d2",
            "speaker": "npc",
            "lines": [
                "Brute forcing my way to the top isn't the right way to go about things, and I should have known that."
            ],
            "input": [
                "q.dialogue.set_page('d3');"
            ]
        },
        {
            "id": "d3",
            "speaker": "npc",
            "lines": [
                "I've started studying, planning, and strategizing more. I think I'm finally starting to understand."
            ],
            "input": [
                "q.dialogue.set_page('d4');"
            ]
        },
        {
            "id": "d4",
            "speaker": "npc",
            "lines": [
                "Also, I think I have come to accept that failure is just a part of learning. It's just something we all have to go through, you know?"
            ],
            "input": [
                "q.dialogue.set_page('d5');"
            ]
        },
        {
            "id": "d5",
            "speaker": "npc",
            "lines": [
                "You can't just try something a few times and expect to be perfect at it. You have to keep trying, keep failing, and keep learning."
            ],
            "input": [
                "q.dialogue.set_page('d6');"
            ]
        },
        {
            "id": "d6",
            "speaker": "npc",
            "lines": [
                "I guess, thanks for being a friend. You've really helped me grow as a trainer."
            ],
            "input": [
                "q.dialogue.set_page('d7');"
            ]
        },
        {
            "id": "d7",
            "speaker": "npc",
            "lines": [
                "I want to keep learning, and I want to keep getting better..."
            ],
            "input": [
                "q.dialogue.set_page('d8');"
            ]
        },
        {
            "id": "d8",
            "speaker": "npc",
            "lines": [
                "When I challenge the league, I want to be ready. Not just for the thrill, but for my team as well."
            ],
            "input": [
                "q.dialogue.set_page('d9');"
            ]
        },
        {
            "id": "d9",
            "speaker": "npc",
            "lines": [
                "Anyway, sorry for the rambling. It's just... nice to have someone to talk to about this stuff."
            ],
            "input": [
                "q.dialogue.set_page('battle_prompt_d');"
            ]
        },
        {
            "id": "battle_prompt_d",
            "speaker": "npc",
            "lines": [
                "So, what do you say? Are you up for another battle?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "§c⚔ Battle ⚔§r",
                        "value": "battle",
                        "action": [
                            "q.dialogue.set_page('battle_start_d');"
                        ]
                    },
                    {
                        "text": "No",
                        "value": "no",
                        "action": "q.dialogue.close();"
                    }
                ]
            }
        },
        {
            "id": "battle_start_d",
            "speaker": "npc",
            "lines": [
                "Hehe, let's see what you've got!"
            ],
            "escapeAction": "0",
            "input": [
                "q.dialogue.close();",
                "v.battle = q.npc.start_battle(q.player);"
            ]
        },
        {
            "id": "interact5",
            "speaker": "npc",
            "lines": [
                "Hey there! Seems like ages since we last talked!"
            ],
            "input": [
                "q.run_script('cobblemon:cooldown_check') ? q.dialogue.set_page('on_cooldown') : q.dialogue.set_page('battle_prompt_e');"
            ]
        },
        {
            "id": "battle_prompt_e",
            "speaker": "npc",
            "lines": [
                "Oh? You want to rematch little ol' me?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "§c⚔ Battle ⚔§r",
                        "value": "battle",
                        "action": [
                            "q.dialogue.set_page('battle_start_e');"
                        ]
                    },
                    {
                        "text": "No",
                        "value": "no",
                        "action": "q.dialogue.close();"
                    }
                ]
            }
        },
        {
            "id": "battle_start_e",
            "speaker": "npc",
            "lines": [
                "Hehe, no problem! Let's see what you've got!"
            ],
            "escapeAction": "0",
            "input": [
                "q.dialogue.close();",
                "v.battle = q.npc.start_battle(q.player);"
            ]
        },
        {
            "id": "on_cooldown",
            "speaker": "npc",
            "lines": [
                "§8§oBattle cooldown is active!\n",
                "§8§oCurrent time remaining:",
                {
                    "type": "expression",
                    "expression": "'§8§o' + q.run_script('cobblemon:cooldown_remaining_time');"
                }
            ],
            "input": "q.dialogue.close();"
        }
    ]
}