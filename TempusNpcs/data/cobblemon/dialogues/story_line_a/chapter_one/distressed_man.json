{
    "speakers": {
        "npc": {
            "name": {
                "type": "expression",
                "expression": "q.npc.name"
            },
            "face": "q.npc.face();",
            "gibber": {
                "interval": 0.1
            }
        },
        "player": {
            "face": "q.player.face(true);",
            "gibber": {
                "interval": 0.1
            },
            "name": {
                "type": "expression",
                "expression": "q.player.username"
            }
        }
    },
    "pages": [
        {
            "id": "man_intro",
            "lines": [
                "§oThe man looks up in the tree, scratching his head with a worried look on his face. He see's you approach and waves.§r"
            ],
            "background": "cobblemon:textures/gui/dialogue/dialogue_box_info.png",
            "textColor": "FFFFFF",
            "input": "q.dialogue.set_page('greeting');"
        },
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                "Hey you! Could you help me out? I'm going to be in big trouble if I can't round up these Pokémon!"
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "I'll help you",
                        "value": "accept",
                        "action": [
                            "q.run_command('ftbquests change_progress ' + q.player.username + ' complete 0B6A97171EA4BC42');",
                            "q.dialogue.set_page('task');"
                        ]
                    },
                    {
                        "text": "Exit",
                        "value": "exit",
                        "action": "q.dialogue.close();"
                    }
                ]
            }
        },
        {
            "id": "task",
            "lines": [
                "Great! There's 43 Pokemon to find around Marino, that's at least one of each type, plus a few extra Grass, Fire and Water types.",
                "You can adopt one of them to take them off my hands."
            ],
            "input": "q.dialogue.close();"
        },
    ]
}