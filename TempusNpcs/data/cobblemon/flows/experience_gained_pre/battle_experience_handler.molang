c.source != 'battle' ? return 0;

t.player = c.pokemon.owner;
t.battle = t.player.battle;

!t.battle.is_pvn ? return 0;

for_each(t.battle_actor, t.battle.actors, {
    t.battle_actor.npc.config.no_experience_toggle ? {
        t.result = q.set_amount(0);
        t.player.tell(q.to_string(t.result));
    };
});