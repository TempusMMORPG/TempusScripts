t.should_run = q.entity.is_doing_activity('idle') && !q.entity.has_walk_target && q.entity.config.toggle_walk;
!t.should_run ? return 0;

t.pos_radius = q.entity.config.pos_radius;
v.speed = q.entity.config.speed;
t.positions = q.run_script('cobblemon:' + q.entity.config.walker_coords_molang_location);
t.num_points = q.length(t.positions);

q.entity.data.current_target_index > (t.num_points - 1) ? { 
    q.entity.data.current_target_index = 0;
};

v.target = t.positions[q.entity.data.current_target_index];

q.run_molang('v.distance_to_target = q.entity.distance_to_pos(' + v.target + ');');
v.is_too_far = v.distance_to_target > t.pos_radius;

t.last_move = q.entity.data.time_since_last_move;
!v.is_too_far ? {
    t.value = q.entity.data.current_target_index + 1;
    q.entity.data.current_target_index = math.mod(t.value, t.num_points);
    v.target = t.positions[q.entity.data.current_target_index];
    t.last_move = q.entity.world.game_time;
};
t.last_move == 0 ? {
    t.last_move = q.entity.world.game_time;
};

q.entity.data.time_since_last_move = t.last_move;

(t.last_move + 6000) >= q.entity.world.game_time ? {
    q.run_molang('q.entity.walk_to(' + v.target + ', v.speed);');
} : {
    t.tp_command = q.replace(v.target, ',', '');
    q.run_command('tp ' + q.entity.uuid + ' ' + t.tp_command);
};