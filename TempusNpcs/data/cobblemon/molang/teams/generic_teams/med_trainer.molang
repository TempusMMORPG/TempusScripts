t.constants = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true level=' + (q.player.party.highest_level - 3);

t.data = q.run_script('cobblemon:gs_gym_leader_difficulty');

t.data == 'SPLITONE'|| t.data == 'SPLITTWO' ? {
t.mons = q.array(
'jigglypuff' + t.constants,
'mankey' + t.constants,
'staryu' + t.constants,
'chinchou' + t.constants,
'natu' + t.constants,
'yanma' + t.constants,
'shroomish' + t.constants,
'aron' + t.constants,
'trapinch' + t.constants,
'buizel' + t.constants,
'pachirisu' + t.constants,
'buneary' + t.constants,
'darumaka' + t.constants,
'woobat' + t.constants,
'scraggy' + t.constants,
'flabebe' + t.constants,
'binacle' + t.constants,
'noibat' + t.constants,
'crabrawler' + t.constants,
'bounsweet' + t.constants,
'mudbray' + t.constants,
'gossifleur' + t.constants,
'milcery' + t.constants,
'cufant' + t.constants,
'shroodle' + t.constants,
'wiglett' + t.constants,
'varoom' + t.constants,
'foongus' + t.constants,
'mienfoo' + t.constants,
'bronzor' + t.constants
);
t.mons_length = q.length(t.mons);

t.loop_count = math.random_integer(1, 2);
loop(t.loop_count, {
    t.index = math.random_integer(0, t.mons_length);
    q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'SPLITTHREE' || t.data == 'SPLITFOUR' ? {
t.mons = q.array(
'wigglytuff' + t.constants,
'primeape' + t.constants,
'miltank' + t.constants,
'lanturn' + t.constants,
'xatu' + t.constants,
'stantler' + t.constants,
'breloom' + t.constants,
'lairon' + t.constants,
'vibrava' + t.constants,
'floatzel' + t.constants,
'carnivine' + t.constants,
'lopunny' + t.constants,
'darmanitan' + t.constants,
'swoobat' + t.constants,
'scrafty' + t.constants,
'florges' + t.constants,
'barbaracle' + t.constants,
'noivern' + t.constants,
'drampa' + t.constants,
'bruxish' + t.constants,
'turtonator' + t.constants,
'eldegoss' + t.constants,
'alcremie' + t.constants,
'copperajah' + t.constants,
'grafaiai' + t.constants,
'flamigo' + t.constants,
'revavroom' + t.constants,
'falinks' + t.constants,
'cramorant' + t.constants,
'maractus' + t.constants
);
t.mons_length = q.length(t.mons);

t.loop_count = math.random_integer(2, 3);
loop(t.loop_count, {
    t.index = math.random_integer(0, t.mons_length);
    q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'SPLITFIVE' || t.data == 'SPLITSIX' ? {
t.mons = q.array(
'wigglytuff' + t.constants,
'annihilape' + t.constants,
'miltank' + t.constants,
'lanturn' + t.constants,
'xatu' + t.constants,
'wyrdeer' + t.constants,
'breloom' + t.constants,
'aggron' + t.constants,
'flygon' + t.constants,
'floatzel' + t.constants,
'carnivine' + t.constants,
'lopunny' + t.constants,
'darmanitan' + t.constants,
'swoobat' + t.constants,
'scrafty' + t.constants,
'florges' + t.constants,
'barbaracle' + t.constants,
'noivern' + t.constants,
'drampa' + t.constants,
'bruxish' + t.constants,
'turtonator' + t.constants,
'eldegoss' + t.constants,
'alcremie' + t.constants,
'copperajah' + t.constants,
'grafaiai' + t.constants,
'flamigo' + t.constants,
'revavroom' + t.constants,
'falinks' + t.constants,
'cramorant' + t.constants,
'maractus' + t.constants
);
t.mons_length = q.length(t.mons);

t.loop_count = math.random_integer(3, 4);
loop(t.loop_count, {
    t.index = math.random_integer(0, t.mons_length);
    q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

return 0;
