t.constants = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true level=' + (q.player.party.highest_level - 5);

t.data = q.run_script('cobblemon:gs_gym_leader_difficulty');

t.data == 'EASY' ? {
t.mons = q.array(
'rattata' + t.constants,
'sentret' + t.constants,
'zigzagoon galarian' + t.constants,
'zigzagoon' + t.constants,
'bidoof' + t.constants,
'patrat' + t.constants,
'rattata alolan' + t.constants,
'bunnelby' + t.constants,
'yungoos' + t.constants,
'skwovet' + t.constants,
'lechonk' + t.constants,
'wooloo' + t.constants,
'pidgey' + t.constants,
'hoothoot' + t.constants,
'tailow' + t.constants,
'starly' + t.constants,
'wingull' + t.constants,
'pidove' + t.constants,
'lillipup' + t.constants,
'fletchling' + t.constants,
'pikipek' + t.constants,
'nickit' + t.constants,
'purrloin' + t.constants,
'smoliv' + t.constants,
'spearow' + t.constants,
'shinx' + t.constants,
'yamper' + t.constants,
'pansage' + t.constants,
'pansear' + t.constants,
'panpour' + t.constants
);
t.mons_length = q.length(t.mons);

t.loop_count = math.random_integer(1, 2);
loop(t.loop_count, {
    t.index = math.random_integer(0, t.mons_length);
    q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'MEDIUM' ? {
t.mons = q.array(
'raticate' + t.constants,
'furret' + t.constants,
'linoone galarian' + t.constants,
'linoone' + t.constants,
'bibarel' + t.constants,
'watchog' + t.constants,
'raticate alolan' + t.constants,
'diggersby' + t.constants,
'gumshoos' + t.constants,
'greedent' + t.constants,
'oinkologne' + t.constants,
'dubwool' + t.constants,
'pidgotto' + t.constants,
'noctowl' + t.constants,
'swellow' + t.constants,
'staravia' + t.constants,
'pelipper' + t.constants,
'tranquill' + t.constants,
'herdier' + t.constants,
'fletchinder' + t.constants,
'trumbeak' + t.constants,
'thievul' + t.constants,
'liepard' + t.constants,
'dolliv' + t.constants,
'fearow' + t.constants,
'luxio' + t.constants,
'boltund' + t.constants,
'simisage' + t.constants,
'simisear' + t.constants,
'simipour' + t.constants
);
t.mons_length = q.length(t.mons);

t.loop_count = math.random_integer(2, 3);
loop(t.loop_count, {
    t.index = math.random_integer(0, t.mons_length);
    q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'HARD' ? {
t.mons = q.array(
'raticate' + t.constants,
'furret' + t.constants,
'obstagoon' + t.constants,
'linoone' + t.constants,
'bibarel' + t.constants,
'watchog' + t.constants,
'raticate alolan' + t.constants,
'diggersby' + t.constants,
'gumshoos' + t.constants,
'greedent' + t.constants,
'oinkologne' + t.constants,
'dubwool' + t.constants,
'pidgeot' + t.constants,
'noctowl' + t.constants,
'swellow' + t.constants,
'staraptor' + t.constants,
'pelipper' + t.constants,
'unfezant' + t.constants,
'stoutland' + t.constants,
'talonflame' + t.constants,
'toucannon' + t.constants,
'theivul' + t.constants,
'liepard' + t.constants,
'arboliva' + t.constants,
'fearow' + t.constants,
'luxray' + t.constants,
'boltund' + t.constants,
'simisage' + t.constants,
'simisear' + t.constants,
'simipour' + t.constants
);
t.mons_length = q.length(t.mons);

t.loop_count = math.random_integer(3, 4);
loop(t.loop_count, {
    t.index = math.random_integer(0, t.mons_length);
    q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

return 0;
