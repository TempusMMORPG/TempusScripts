t.constants = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true level=' + (q.player.party.highest_level - 1);

t.data = q.run_script('cobblemon:gs_gym_leader_difficulty');

t.data == 'SPLITONE'|| 'SPLITTWO' ? {
t.mons = q.array(
'ivysaur' + t.constants,
'charmeleon' + t.constants,
'wartortle' + t.constants,
'onix' + t.constants,
'pupitar' + t.constants,
'sneasel' + t.constants,
'kirlia' + t.constants,
'metang' + t.constants,
'feebas' + t.constants,
'riolu' + t.constants,
'gabite' + t.constants,
'roselia' + t.constants,
'zorua' + t.constants,
'litwick' + t.constants,
'larvesta' + t.constants,
'honedge' + t.constants,
'skrelp' + t.constants,
'sliggoo' + t.constants,
'dartrix' + t.constants,
'torracat' + t.constants,
'brionne' + t.constants,
'hattrem' + t.constants,
'morgrem' + t.constants,
'pincurchin' + t.constants,
'sneasel hisuian' + t.constants,
'zorua hisuian' + t.constants,
'teddiursa' + t.constants,
'charcadet' + t.constants,
'naclstack' + t.constants,
'squawkabilly' + t.constants
);
t.mons_length = q.length(t.mons);

t.loop_count = math.random_integer(1, 2);
loop(t.loop_count, {
    t.index = math.random_integer(0, t.mons_length);
    q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'SPLITTHREE' || t.data == 'SPLITFOUR' ? {
t.mons = q.array(
'venusaur' + t.constants,
'charizard' + t.constants,
'blastoise' + t.constants,
'steelix' + t.constants,
'pupitar' + t.constants,
'weavile' + t.constants,
'gardevoir' + t.constants,
'metang' + t.constants,
'milotic' + t.constants,
'lucario' + t.constants,
'gabite' + t.constants,
'roserade' + t.constants,
'zoroark' + t.constants,
'chandelure' + t.constants,
'larvesta' + t.constants,
'aegislash' + t.constants,
'dragalge' + t.constants,
'sliggoo' + t.constants,
'decidueye' + t.constants,
'incineroar' + t.constants,
'primarina' + t.constants,
'hatterene' + t.constants,
'grimmsnarl' + t.constants,
'sirfetchd' + t.constants,
'sneasler' + t.constants,
'zoroark hisuian' + t.constants,
'ursaring' + t.constants,
'ceruledge' + t.constants,
'garganacl' + t.constants,
'armarouge' + t.constants
);
t.mons_length = q.length(t.mons);

t.loop_count = math.random_integer(2, 3);
loop(t.loop_count, {
    t.index = math.random_integer(0, t.mons_length);
    q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'SPLITFIVE' || t.data == 'SPLITSIX' ? {
t.mons = q.array(
'venusaur' + t.constants,
'charizard' + t.constants,
'blastoise' + t.constants,
'steelix' + t.constants,
'tyranitar' + t.constants,
'weavile' + t.constants,
'gardevoir' + t.constants,
'metagross' + t.constants,
'milotic' + t.constants,
'lucario' + t.constants,
'garchomp' + t.constants,
'roserade' + t.constants,
'zoroark' + t.constants,
'chandelure' + t.constants,
'volcarona' + t.constants,
'aegislash' + t.constants,
'dragalge' + t.constants,
'goodra' + t.constants,
'decidueye' + t.constants,
'incineroar' + t.constants,
'primarina' + t.constants,
'hatterene' + t.constants,
'grimmsnarl' + t.constants,
'sirfetchd' + t.constants,
'sneasler' + t.constants,
'zoroark hisuian' + t.constants,
'ursaluna' + t.constants,
'ceruledge' + t.constants,
'garganacl' + t.constants,
'armarouge' + t.constants
);
t.mons_length = q.length(t.mons);

t.loop_count = math.random_integer(3, 4);
loop(t.loop_count, {
    t.index = math.random_integer(0, t.mons_length);
    q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

return 0;
