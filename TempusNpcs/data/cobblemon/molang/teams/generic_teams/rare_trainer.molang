t.constants = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true level=' + (q.player.party.highest_level - 2);

t.data = q.run_script('cobblemon:gs_gym_leader_difficulty');

t.data == 'SPLITONE'|| t.data == 'SPLITTWO' ? {
t.mons = q.array(
'porygon' + t.constants,
'happiny' + t.constants,
'goldeen' + t.constants,
'rhyhorn' + t.constants,
'magby' + t.constants,
'elekid' + t.constants,
'aerodactyl' + t.constants,
'omanyte' + t.constants,
'kabuto' + t.constants,
'lileep' + t.constants,
'anorith' + t.constants,
'cranidos' + t.constants,
'shieldon' + t.constants,
'archen' + t.constants,
'tirtouga' + t.constants,
'amaura' + t.constants,
'tyrunt' + t.constants,
'venonat' + t.constants,
'exeggcute' + t.constants,
'nosepass' + t.constants,
'misdreavus' + t.constants,
'eevee' + t.constants,
'lickitung' + t.constants,
'murkrow' + t.constants,
'wynaut' + t.constants,
'shuckle' + t.constants,
'chatot' + t.constants,
'tropius' + t.constants,
'doduo' + t.constants,
'munchlax' + t.constants
);
t.mons_length = q.length(t.mons);

t.loop_count = math.random_integer(1, 2);
loop(t.loop_count, {
    t.index = math.random_integer(0, t.mons_length);
    q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'SPLITTHREE' || t.data == 'SPLITFOUR' ? {
t.mons = q.array(
'porygon2' + t.constants,
'chansey' + t.constants,
'lapras' + t.constants,
'rhydon' + t.constants,
'magmar' + t.constants,
'electabuzz' + t.constants,
'aerodactyl' + t.constants,
'omastar' + t.constants,
'kabutops' + t.constants,
'cradily' + t.constants,
'armaldo' + t.constants,
'rampardos' + t.constants,
'bastiodon' + t.constants,
'pinsir' + t.constants,
'heracross' + t.constants,
'lickilicky' + t.constants,
'wobbuffet' + t.constants,
'dracozolt' + t.constants,
'arcovish' + t.constants,
'chatot' + t.constants,
'tropius' + t.constants,
'flareon' + t.constants,
'jolteon' + t.constants,
'vaporeon' + t.constants,
'leafeon' + t.constants,
'umbreon' + t.constants,
'espeon' + t.constants,
'glaceon' + t.constants,
'sylveon' + t.constants,
'snorlax' + t.constants
);
t.mons_length = q.length(t.mons);

t.loop_count = math.random_integer(2, 3);
loop(t.loop_count, {
    t.index = math.random_integer(0, t.mons_length);
    q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'SPLITFIVE' || t.data == 'SPLITSIX' ? {
t.mons = q.array(
'porygonz' + t.constants,
'blissey' + t.constants,
'lapras' + t.constants,
'rhyperior' + t.constants,
'magmortar' + t.constants,
'electivire' + t.constants,
'aerodactyl' + t.constants,
'omastar' + t.constants,
'kabutops' + t.constants,
'cradily' + t.constants,
'armaldo' + t.constants,
'rampardos' + t.constants,
'bastiodon' + t.constants,
'pinsir' + t.constants,
'heracross' + t.constants,
'lickilicky' + t.constants,
'wobbuffet' + t.constants,
'dracozolt' + t.constants,
'arcovish' + t.constants,
'chatot' + t.constants,
'tropius' + t.constants,
'flareon' + t.constants,
'jolteon' + t.constants,
'vaporeon' + t.constants,
'leafeon' + t.constants,
'umbreon' + t.constants,
'espeon' + t.constants,
'glaceon' + t.constants,
'sylveon' + t.constants,
'snorlax' + t.constants
);
t.mons_length = q.length(t.mons);

t.loop_count = math.random_integer(3, 4);
loop(t.loop_count, {
    t.index = math.random_integer(0, t.mons_length);
    q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

return 0;
