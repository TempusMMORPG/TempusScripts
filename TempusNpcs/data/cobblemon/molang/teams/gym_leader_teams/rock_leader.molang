t.constants = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true pokeball=ultra_ball';

t.data = q.run_script('cobblemon:gs_gym_leader_difficulty');

t.data == 'EASY' ? {
    q.party.add_by_properties('roggenrola moves=smackdown,mudslap,stealthrock,rocksmash nature=quiet held_item=cobblemon:sitrus_berry ability=sturdy hp_ev=64 attack_ev=64 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('rockruff moves=rocktomb,bite,howl,tackle nature=relaxed held_item=cobblemon:sitrus_berry ability=owntempo attack_ev=64 speed_ev=64 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('rhyhorn moves=smackdown,bulldoze,stomp,pursuit nature=naive held_item=cobblemon:sitrus_berry hp_ev=64 attack_ev=64 ability=rockhead level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('carkol moves=flamecharge,rocktomb,takedown,rapidspin nature=brave held_item=cobblemon:hard_stone ability=steamengine hp_ev=80 attack_ev=80 level=' + (q.player.party.highest_level + 1) + t.constants);
    return 1;
};

t.data == 'MEDIUM' ? {
    q.party.add_by_properties('boldore moves=rockslide,stealthrock,heavyslam,bulldoze nature=brave held_item=cobblemon:custap_berry ability=sturdy hp_ev=128 attack_ev=128 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('lycanroc wolf_form=dusk moves=accelerock,brickbreak,drillrun,rockslide nature=lonely held_item=cobblemon:hard_stone ability=toughclaws attack_ev=128 speed_ev=128 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('rhydon moves=rockslide,highhorsepower,icepunch,poisonjab nature=naughty held_item=cobblemon:rindo_berry ability=rockhead hp_ev=128 attack_ev=128 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('aerodactyl moves=dualwingbeat,rockslide,icefang,firefang nature=naughty held_item=cobblemon:sharp_beak ability=unnerve attack_ev=128 speed_ev=128 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('coalossal moves=rockslide,heatcrash,heavyslam,highhorsepower nature=adamant held_item=cobblemon:passho_berry ability=steamengine hp_ev=160 attack_ev=160 level=' + (q.player.party.highest_level + 1) + t.constants);
    return 1;
};

t.data == 'HARD' ? {
    q.party.add_by_properties('gigalith moves=stealthrock,stoneedge,earthquake,heavyslam nature=adamant held_item=cobblemon:smooth_rock ability=sandstream hp_ev=252 attack_ev=252 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('minior moves=acrobatics,stoneedge,earthquake,shellsmash nature=jolly held_item=cobblemon:flying_gem ability=shieldsdown attack_ev=252 speed_ev=252 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('lycanroc wolf_form=dusk moves=accelerock,stoneedge,closecombat,earthquake nature=jolly held_item=cobblemon:life_orb ability=toughclaws attack_ev=252 speed_ev=252 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('rhyperior moves=stoneedge,earthquake,temperflare,icepunch nature=adamant held_item=cobblemon:rindo_berry ability=solidrock hp_ev=252 attack_ev=252 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('aerodactyl mega_evolution=mega moves=dualwingbeat,stoneedge,earthquake,icefang nature=adamant held_item=mega_showdown:aerodactylite ability=toughclaws attack_ev=252 speed_ev=252 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('coalossal moves=stoneedge,heatcrash,heavyslam,earthquake nature=adamant held_item=cobblemon:passho_berry ability=steamengine hp_ev=252 attack_ev=252 level=' + (q.player.party.highest_level + 1) + t.constants);
