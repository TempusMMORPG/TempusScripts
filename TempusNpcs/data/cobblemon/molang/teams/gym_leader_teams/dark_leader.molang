t.constants = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true pokeball=ultra_ball';

t.data = q.run_script('cobblemon:gs_gym_leader_difficulty');

t.data == 'EASY' ? {
    q.party.add_by_properties('morpeko moves=bite,quickattack,flatter,spark nature=lax held_item=cobblemon:sitrus_berry ability=hungerswitch attack_ev=64 speed_ev=64 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('zorua moves=knockoff,furyswipes,honeclaws,taunt nature=hardy held_item=cobblemon:sitrus_berry ability=illusion attack_ev=64 speed_ev=64 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('sandile moves=bite,dig,honeclaws,scaryface nature=naive held_item=cobblemon:sitrus_berry ability=intimidate attack_ev=64 speed_ev=64 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('murkrow moves=wingattack,assurance,nightshade,haze nature=lonely held_item=cobblemon:black_glasses ability=superluck attack_ev=80 speed_ev=80 level=' + (q.player.party.highest_level + 1) + t.constants);
    return 1;
};

t.data == 'MEDIUM' ? {
    q.party.add_by_properties('morpeko moves=crunch,partingshot,seedbomb,psychicfangs nature=naive held_item=cobblemon:chople_berry ability=hungerswitch attack_ev=128 speed_ev=128 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('krookodile moves=highhorsepower,knockoff,rockslide,dragonclaw nature=hasty held_item=cobblemon:black_glasses ability=moxie attack_ev=128 speed_ev=128 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('zoroark moves=darkpulse,flamethrower,sludgebomb,psychic nature=mild held_item=cobblemon:expert_belt ability=illusion special_attack_ev=128 speed_ev=128 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('absol moves=knockoff,playrough,suckerpunch,rockslide nature=naughty held_item=cobblemon:muscle_band ability=superluck attack_ev=128 speed_ev=129 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('honchkrow moves=lashout,suckerpunch,doubleedge,dualwingbeat nature=adamant held_item=cobblemon:life_orb ability=moxie hp_ev=160 attack_ev=160 level=' + (q.player.party.highest_level + 1) + t.constants);
    return 1;
};

t.data == 'HARD' ? {    
    q.party.add_by_properties('morpeko moves=aurawheel,knockoff,psychicfangs,partingshot nature=adamant held_item=cobblemon:focus_sash ability=hungerswitch attack_ev=252 speed_ev=252 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('krookodile moves=earthquake,knockoff,gunkshot,stoneedge nature=jolly held_item=cobblemon:choice_scarf ability=moxie attack_ev=252 speed_ev=252 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('zoroark moves=darkpulse,sludgebomb,focusblast,flamethrower nature=timid held_item=cobblemon:life_orb ability=illusion special_attack_ev=252 speed_ev=252 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('bisharp moves=ironhead,knockoff,suckerpunch,swordsdance nature=adamant held_item=cobblemon:eviolite ability=defiant hp_ev=252 attack_ev=252 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('absol mega_evolution=mega moves=knockoff,closecombat,suckerpunch,playrough nature=jolly held_item=mega_showdown:absolite ability=magicbounce attack_ev=252 speed_ev=252 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('honchkrow moves=bravebird,lashout,suckerpunch,superpower nature=adamant held_item=cobblemon:life_orb ability=moxie hp_ev=252 attack_ev=252 level=' + (q.player.party.highest_level + 1) + t.constants);
    return 1;
};

return 0;
