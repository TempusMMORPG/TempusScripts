t.constants = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true';

t.data = q.run_script('cobblemon:gs_gym_leader_difficulty');

t.data == 'EASY' ? {
    q.party.add_by_properties('monferno moves=machpunch,flamewheel,furyswipes,ember nature=serious held_item=cobblemon:sitrus_berry ability=blaze attack_ev=64 speed_ev=64 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('clobbopus moves=brickbreak,bind,bulkup,brine nature=mild held_item=cobblemon:sitrus_berry ability=limber hp_ev=64 attack_ev=64 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('scraggy moves=facade,lowkick,payback,sandattack nature=relaxed held_item=cobblemon:sitrus_berry hp_ev=64 attack_ev=64 ability= level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('meditite moves=forcepalm,zenheadbutt,workup,aerialace nature=lonely held_item=cobblemon:black_belt ability=purepower attack_ev=80 speed_ev=80 level=' + (q.player.party.highest_level + 1) + t.constants);
    return 1;
};

t.data == 'MEDIUM' ? {
    q.party.add_by_properties('infernape moves=flamethrower,aurasphere,grassknot,uturn nature=mild held_item=cobblemon:expert_belt ability=blaze special_attack_ev=128 speed_ev=128 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('sawk moves=brickbreak,throatchop,rockslide,poisonjab nature=brave held_item=cobblemon:salac_berry ability=sturdy attack_ev=128 speed_ev=128 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('grapploct moves=drainpunch,payback,waterfall,skittersmack nature=naughty held_item=cobblemon:muscle_band ability=limber hp_ev=128 attack_ev=128 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('scrafty moves=crunch,drainpunch,poisonjab,rockslide nature=lonely held_item=cobblemon:roseli_berry ability=moxie hp_ev=128 attack_ev=128 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('medicham moves=zenheadbutt,drainpunch,bulletpunch,firepunch nature=jolly held_item=cobblemon:life_orb ability=purepower attack_ev=160 speed_ev=160 level=' + (q.player.party.highest_level + 1) + t.constants);
    return 1;
};

t.data == 'HARD' ? {
    q.party.add_by_properties('infernape moves=fireblast,focusblast,gunkshot,stoneedge nature=hasty held_item=cobblemon:expert_belt ability=blaze special_attack_ev=252 speed_ev=252 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('sawk moves=closecombat,poisonjab,icepunch,throatchop nature=jolly held_item=cobblemon:weakness_policy ability=sturdy attack_ev=252 speed_ev=252 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('scrafty moves=crunch,poisonjab,closecombat,stoneedge nature=adamant held_item=cobblemon:quick_claw ability=moxie hp_ev=252 attack_ev=252 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('grapploct moves=closecombat,liquidation,payback,poweruppunch nature=adamant held_item=cobblemon:payapa_berry ability=limber hp_ev=252 attack_ev=252 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('lucario moves=aurasphere,flashcannon,darkpulse,psychic nature=timid held_item=cobblemon:choice_specs ability=steadfast special_attack_ev=252 speed_ev=252 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('medicham moves=zenheadbutt,drainpunch,bulletpunch,firepunch nature=jolly ability=purepower attack_ev=252 speed_ev=252 level=' + (q.player.party.highest_level + 1) + t.constants);
    return 1;
};

