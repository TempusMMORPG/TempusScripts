t.constants = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true friendship=255 pokeball=ultra_ball';

t.data = q.run_script('cobblemon:gs_gym_leader_difficulty');

t.data == 'SPLITONE' && q.player.data.hard_mode ? {
