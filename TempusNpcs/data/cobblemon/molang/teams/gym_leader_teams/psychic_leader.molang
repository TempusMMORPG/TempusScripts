    q.party.add_by_properties('orbeetle moves=psychic,bugbuzz,bodypress,energyball nature=modest held_item=cobblemon:colbur_berry ability=swarm special_attack_ev=252 speed_ev=252 level=' + (q.player.party.highest_level) + t.constants);
