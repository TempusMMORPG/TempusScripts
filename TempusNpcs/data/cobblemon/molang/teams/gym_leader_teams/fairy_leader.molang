t.constants = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true pokeball=ultra_ball';

t.data = q.run_script('cobblemon:gs_gym_leader_difficulty');

t.data == 'EASY' ? {
    q.party.add_by_properties('cutiefly moves=drainingkiss,strugglebug,stunspore,round nature=relaxed held_item=cobblemon:sitrus_berry ability=shielddust special_attack_ev=64 speed_ev=64 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('kirlia moves=psybeam,drainingkiss,hypnosis,doubleteam nature=gentle held_item=cobblemon:sitrus_berry ability=trace special_attack_ev=64 speed_ev=64 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('morelull moves=megadrain,drainingkiss,sleeppowder,moonlight nature=lax held_item=cobblemon:sitrus_berry ability=effectspore hp_ev=64 special_attack_ev=64 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('floette flower=pink moves=magicalleaf,drainingkiss,wish,hiddenpower nature=quiet held_item=cobblemon:fairy_feather ability=flowerveil hp_ev=80 special_attack_ev=80 level=' + (q.player.party.highest_level + 1) + t.constants);
    return 1;
};

t.data == 'MEDIUM' ? {
    q.party.add_by_properties('ribombee moves=pollenpuff,stickyweb,dazzlinggleam,psychic nature=naive held_item=cobblemon:fairy_feather ability=shielddust special_attack_ev=128 speed_ev=128 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('comfey moves=calmmind,drainingkiss,gigadrain,synthesis nature=mild held_item=cobblemon:big_root ability=triage hp_ev=128 special_attack_ev=128 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('shiinotic moves=strengthsap,spore,moonblast,gigadrain nature=relaxed held_item=cobblemon:mental_herb ability=effectspore hp_ev=128 special_attack_ev=128 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('gardevoir moves=psychic,moonblast,energyball,mysticalfire nature=rash held_item=cobblemon:expert_belt ability=trace special_attack_ev=128 speed_ev=128 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('florges flower=pink moves=moonblast,psychic,gigadrain,calmmind nature=modest held_item=cobblemon:leftovers ability=symbiosis hp_ev=160 special_attack_ev=160 level=' + (q.player.party.highest_level + 1) + t.constants);
    return 1;
};

t.data == 'HARD' ? {
    q.party.add_by_properties('ribombee moves=stickyweb,moonblast,stunspore,psychicnoise nature=timid held_item=cobblemon:focus_sash ability=shielddust special_attack_ev=252 speed_ev=252 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('hatterene moves=psyshock,mysticalfire,calmmind,drainingkiss nature=bold held_item=cobblemon:leftovers ability=magicbounce hp_ev=252 special_attack_ev=252 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('comfey moves=calmmind,drainingkiss,gigadrain,synthesis nature=modest held_item=cobblemon:life_orb ability=triage hp_ev=252 special_attack_ev=252 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('gardevoir mega_evolution=mega moves=hypervoice,psychic,focusblast,mysticalfire nature=timid held_item=mega_showdown:gardevoirite ability=pixilate special_attack_ev=252 speed_ev=252 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('shiinotic moves=strengthsap,spore,moonblast,gigadrain nature=bold held_item=cobblemon:rocky_helmet ability=effectspore hp_ev=252 defence_ev=252 level=' + (q.player.party.highest_level) + t.constants);
    q.party.add_by_properties('florges flower=pink moves=moonblast,psychic,gigadrain,calmmind nature=modest held_item=cobblemon:leftovers ability=symbiosis hp_ev=252 special_attack_ev=252 level=' + (q.player.party.highest_level + 1) + t.constants);
    return 1;
};

return 0;
