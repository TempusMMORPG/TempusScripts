t.constants = ' level=10 hp_iv=15 attack_iv=15 defence_iv=15 special_attack_iv=15 special_defence_iv=15 speed_iv=15 uncatchable=true';

t.mons = q.array(
'lillipup' + t.constants,
'houndour' + t.constants,
'rockruff' + t.constants,
'growlithe' + t.constants,
'yamper' + t.constants,
'snubbull' + t.constants,
'poochyena' + t.constants,
'maschiff' + t.constants,
'electrike' + t.constants,
'greavard' + t.constants
);
t.mons_length = q.length(t.mons);

loop(2, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
