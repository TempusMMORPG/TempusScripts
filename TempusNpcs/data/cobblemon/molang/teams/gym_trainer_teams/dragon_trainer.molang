t.constants = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry level=' + (q.player.party.highest_level - 2);
t.constants_hard = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry hp_ev=80 attack_ev=80 defence_ev=80 special_attack_ev=80 special_defence_ev=80 speed_ev=80 level=' + (q.player.party.highest_level - 2);

t.data = q.run_script('cobblemon:gs_gym_leader_difficulty');

t.data == 'EASY' ? {
t.mons = q.array(
'dratini' + t.constants,
'axew' + t.constants,
'bagon' + t.constants,
'goomy' + t.constants,
'jangmoo' + t.constants,
'gible' + t.constants,
'dreepy' + t.constants,
'deino' + t.constants,
'tyrunt' + t.constants,
'noibat' + t.constants,
'applin' + t.constants,
'frigibax' + t.constants,
'turtonator' + t.constants,
'drampa' + t.constants,
'exeggutor alolan' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'MEDIUM' ? {
t.mons = q.array(
'dragonair' + t.constants,
'fraxure' + t.constants,
'shelgon' + t.constants,
'sliggoo' + t.constants,
'hakamoo' + t.constants,
'gabite' + t.constants,
'drakloak' + t.constants,
'zweilous' + t.constants,
'tyrantrum' + t.constants,
'sliggoo hisuian' + t.constants,
'dragalge' + t.constants,
'arctibax' + t.constants,
'turtonator' + t.constants,
'drampa' + t.constants,
'exeggutor alolan' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'HARD' ? {
t.mons = q.array(
'dragonite' + t.constants,
'haxorus' + t.constants,
'salamence' + t.constants,
'goodra' + t.constants,
'kommoo' + t.constants,
'garchomp' + t.constants,
'dragapult' + t.constants,
'hydreigon' + t.constants,
'tyrantrum' + t.constants,
'goodra hisuian' + t.constants,
'dragalge' + t.constants,
'baxcalibur' + t.constants,
'turtonator' + t.constants,
'drampa' + t.constants,
'exeggutor alolan' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};
return 0;