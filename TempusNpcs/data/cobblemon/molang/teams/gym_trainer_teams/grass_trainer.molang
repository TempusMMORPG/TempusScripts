t.constants = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry level=' + (q.player.party.highest_level - 2);
t.constants_hard = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry hp_ev=80 attack_ev=80 defence_ev=80 special_attack_ev=80 special_defence_ev=80 speed_ev=80 level=' + (q.player.party.highest_level - 2);

t.data = q.run_script('cobblemon:gs_gym_leader_difficulty');

t.data == 'EASY' ? {
t.mons = q.array(
'sunkern' + t.constants,
'cherubi' + t.constants,
'petilil' + t.constants,
'fomantis' + t.constants,
'steenee' + t.constants,
'gossifleur' + t.constants,
'oddish' + t.constants,
'exeggcute' + t.constants,
'budew' + t.constants,
'smoliv' + t.constants,
'deerling' + t.constants,
'pumpkaboo' + t.constants,
'applin' + t.constants,
'grotle' + t.constants,
'bayleef' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'MEDIUM' ? {
t.mons = q.array(
'sunflora' + t.constants,
'cherrim' + t.constants,
'lilligant' + t.constants,
'lurantis' + t.constants,
'tsareena' + t.constants,
'eldegoss' + t.constants,
'bellossom' + t.constants,
'exeggutor' + t.constants,
'roserade' + t.constants,
'arboliva' + t.constants,
'sawsbuck' + t.constants,
'gourgeist' + t.constants,
'dipplin' + t.constants,
'flapple' + t.constants,
'applin' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'HARD' ? {
t.mons = q.array(
'sunflora' + t.constants,
'cherrim' + t.constants,
'lilligant' + t.constants,
'lurantis' + t.constants,
'tsareena' + t.constants,
'eldegoss' + t.constants,
'bellossom' + t.constants,
'exeggutor' + t.constants,
'roserade' + t.constants,
'arboliva' + t.constants,
'sawsbuck' + t.constants,
'gourgeist' + t.constants,
'hydrapple' + t.constants,
'flapple' + t.constants,
'applin' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};
return 0;