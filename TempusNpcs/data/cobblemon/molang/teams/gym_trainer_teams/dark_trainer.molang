t.constants = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry level=' + (q.player.party.highest_level - 2);
t.constants_hard = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry hp_ev=80 attack_ev=80 defence_ev=80 special_attack_ev=80 special_defence_ev=80 speed_ev=80 level=' + (q.player.party.highest_level - 2);

t.data = q.run_script('cobblemon:gs_gym_leader_difficulty');

t.data == 'EASY' ? {
t.mons = q.array(
'meowth alolan' + t.constants,
'zorua' + t.constants,
'purrloin' + t.constants,
'houndour' + t.constants,
'murkrow' + t.constants,
'sableye' + t.constants,
'scraggy' + t.constants,
'sneasel' + t.constants,
'inkay' + t.constants,
'impidimp' + t.constants,
'grimer alolan' + t.constants,
'carvanha' + t.constants,
'sandile' + t.constants,
'morpeko' + t.constants,
'thievul' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'MEDIUM' ? {
t.mons = q.array(
'persian alolan' + t.constants,
'zoroark' + t.constants,
'liepard' + t.constants,
'houndoom' + t.constants,
'honchkrow' + t.constants,
'sableye' + t.constants,
'scrafty' + t.constants,
'weavile' + t.constants,
'malamar' + t.constants,
'morgrem' + t.constants,
'pangoro' + t.constants,
'spiritomb' + t.constants,
'krokorok' + t.constants,
'morpeko' + t.constants,
'thievul' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'HARD' ? {
t.mons = q.array(
'persian alolan' + t.constants,
'zoroark' + t.constants,
'liepard' + t.constants,
'houndoom' + t.constants,
'honchkrow' + t.constants,
'sableye' + t.constants,
'scrafty' + t.constants,
'weavile' + t.constants,
'malamar' + t.constants,
'grimmsnarl' + t.constants,
'pangoro' + t.constants,
'spiritomb' + t.constants,
'krookodile' + t.constants,
'morpeko' + t.constants,
'thievul' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};
return 0;