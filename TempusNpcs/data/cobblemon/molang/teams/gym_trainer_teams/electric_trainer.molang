t.constants = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry level=' + (q.player.party.highest_level - 2);
t.constants_hard = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry hp_ev=80 attack_ev=80 defence_ev=80 special_attack_ev=80 special_defence_ev=80 speed_ev=80 level=' + (q.player.party.highest_level - 2);

t.data = q.run_script('cobblemon:gs_gym_leader_difficulty');

t.data == 'EASY' ? {
t.mons = q.array(
'pikachu' + t.constants,
'voltorb' + t.constants,
'elekid' + t.constants,
'flaaffy' + t.constants,
'tynamo' + t.constants,
'yamper' + t.constants,
'voltorb hisuian' + t.constants,
'plusle' + t.constants,
'minun' + t.constants,
'magnemite' + t.constants,
'dedenne' + t.constants,
'morpeko' + t.constants,
'emolga' + t.constants,
'pachirisu' + t.constants,
'pawmo' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'MEDIUM' ? {
t.mons = q.array(
'raichu' + t.constants,
'electrode' + t.constants,
'electabuzz' + t.constants,
'ampharos' + t.constants,
'eelektross' + t.constants,
'boltund' + t.constants,
'electrode hisuian' + t.constants,
'raichu alolan' + t.constants,
'rotom' + t.constants,
'magneton' + t.constants,
'toxtricity' + t.constants,
'morpeko' + t.constants,
'emolga' + t.constants,
'togedemaru' + t.constants,
'pawmot' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'HARD' ? {
t.mons = q.array(
'raichu' + t.constants,
'electrode' + t.constants,
'electivire' + t.constants,
'ampharos' + t.constants,
'eelektross' + t.constants,
'boltund' + t.constants,
'electrode hisuian' + t.constants,
'raichu alolan' + t.constants,
'rotom' + t.constants,
'magnezone' + t.constants,
'toxtricity' + t.constants,
'morpeko' + t.constants,
'emolga' + t.constants,
'togedemaru' + t.constants,
'pawmot' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};
return 0;