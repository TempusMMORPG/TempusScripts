t.constants = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry level=' + (q.player.party.highest_level - 2);
t.constants_hard = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry hp_ev=80 attack_ev=80 defence_ev=80 special_attack_ev=80 special_defence_ev=80 speed_ev=80 level=' + (q.player.party.highest_level - 2);

t.data = q.run_script('cobblemon:gs_gym_leader_difficulty');

t.data == 'EASY' ? {
t.mons = q.array(
'grimer' + t.constants,
'koffing' + t.constants,
'gulpin' + t.constants,
'trubbish' + t.constants,
'grimer alolan' + t.constants,
'mareanie' + t.constants,
'tentacool' + t.constants,
'qwilfish' + t.constants,
'varoom' + t.constants,
'venonat' + t.constants,
'salandit' + t.constants,
'skrelp' + t.constants,
'skorupi' + t.constants,
'stunky' + t.constants,
'wooper paldean' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'MEDIUM' ? {
t.mons = q.array(
'muk' + t.constants,
'weezing' + t.constants,
'swalot' + t.constants,
'garbodor' + t.constants,
'muk alolan' + t.constants,
'toxapex' + t.constants,
'tentacruel' + t.constants,
'overqwil' + t.constants,
'revavroom' + t.constants,
'venomoth' + t.constants,
'salazzle' + t.constants,
'skrelp' + t.constants,
'drapion' + t.constants,
'skuntank' + t.constants,
'clodsire' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'HARD' ? {
t.mons = q.array(
'muk' + t.constants,
'weezing' + t.constants,
'swalot' + t.constants,
'garbodor' + t.constants,
'muk alolan' + t.constants,
'toxapex' + t.constants,
'tentacruel' + t.constants,
'overqwil' + t.constants,
'revavroom' + t.constants,
'venomoth' + t.constants,
'salazzle' + t.constants,
'dragalge' + t.constants,
'drapion' + t.constants,
'skuntank' + t.constants,
'clodsire' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};
return 0;