t.constants = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry level=' + (q.player.party.highest_level - 2);
t.constants_hard = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true shiny=yes held_item=cobblemon:sitrus_berry hp_ev=80 attack_ev=80 defence_ev=80 special_attack_ev=80 special_defence_ev=80 speed_ev=80 level=' + (q.player.party.highest_level - 2);

t.data = q.run_script('cobblemon:gs_gym_leader_difficulty');

t.data == 'EASY' ? {
t.mons = q.array(
'butterfree' + t.constants,
'beedrill' + t.constants,
'yanma' + t.constants,
'kricketune' + t.constants,
'spidops' + t.constants,
'ledian' + t.constants,
'beautifly' + t.constants,
'dustox' + t.constants,
'venipede' + t.constants,
'sewaddle' + t.constants,
'dwebble' + t.constants,
'karrablast' + t.constants,
'shelmet' + t.constants,
'charjabug' + t.constants,
'dewpider' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'MEDIUM' ? {
t.mons = q.array(
'scyther' + t.constants,
'heracross' + t.constants,
'pinsir' + t.constants,
'armaldo' + t.constants,
'lokix' + t.constants,
'durant' + t.constants,
'galvantula' + t.constants,
'yanmega' + t.constants,
'scolipede' + t.constants,
'leavanny' + t.constants,
'crustle' + t.constants,
'escavalier' + t.constants,
'accelgor' + t.constants,
'vikavolt' + t.constants,
'araquanid' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'HARD' ? {
t.mons = q.array(
'scyther' + t.constants_hard,
'heracross' + t.constants_hard,
'pinsir' + t.constants_hard,
'armaldo' + t.constants_hard,
'lokix' + t.constants_hard,
'durant' + t.constants_hard,
'galvantula' + t.constants_hard,
'yanmega' + t.constants_hard,
'scolipede' + t.constants_hard,
'leavanny' + t.constants_hard,
'crustle' + t.constants_hard,
'escavalier' + t.constants_hard,
'accelgor' + t.constants_hard,
'vikavolt' + t.constants_hard,
'araquanid' + t.constants_hard
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};
return 0;