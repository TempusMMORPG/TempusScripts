t.constants = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry level=' + (q.player.party.highest_level - 2);
t.constants_hard = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry hp_ev=80 attack_ev=80 defence_ev=80 special_attack_ev=80 special_defence_ev=80 speed_ev=80 level=' + (q.player.party.highest_level - 2);

t.data = q.run_script('cobblemon:gs_gym_leader_difficulty');

t.data == 'EASY' ? {
t.mons = q.array(
'machop' + t.constants,
'hitmonlee' + t.constants,
'hitmonchan' + t.constants,
'hitmontop' + t.constants,
'makuhita' + t.constants,
'mienfoo' + t.constants,
'meditite' + t.constants,
'riolu' + t.constants,
'combusken' + t.constants,
'monferno' + t.constants,
'croagunk' + t.constants,
'pawmo' + t.constants,
'scraggy' + t.constants,
'sneasel hisuian' + t.constants,
'clobbopus' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'MEDIUM' ? {
t.mons = q.array(
'machoke' + t.constants,
'hitmonlee' + t.constants,
'hitmonchan' + t.constants,
'hitmontop' + t.constants,
'hariyama' + t.constants,
'mienfoo' + t.constants,
'meditite' + t.constants,
'lucario' + t.constants,
'blaziken' + t.constants,
'infernape' + t.constants,
'toxicroak' + t.constants,
'pawmot' + t.constants,
'lilligant hisuian' + t.constants,
'throh' + t.constants,
'sawk' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'HARD' ? {
t.mons = q.array(
'machamp' + t.constants,
'hitmonlee' + t.constants,
'hitmonchan' + t.constants,
'hitmontop' + t.constants,
'hariyama' + t.constants,
'mienshao' + t.constants,
'meditite' + t.constants,
'lucario' + t.constants,
'blaziken' + t.constants,
'infernape' + t.constants,
'toxicroak' + t.constants,
'pawmot' + t.constants,
'lilligant hisuian' + t.constants,
'throh' + t.constants,
'sawk' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};
return 0;