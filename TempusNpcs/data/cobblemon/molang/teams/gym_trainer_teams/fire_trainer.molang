t.constants = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry level=' + (q.player.party.highest_level - 2);
t.constants_hard = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry hp_ev=80 attack_ev=80 defence_ev=80 special_attack_ev=80 special_defence_ev=80 speed_ev=80 level=' + (q.player.party.highest_level - 2);

t.data = q.run_script('cobblemon:gs_gym_leader_difficulty');

t.data == 'EASY' ? {
t.mons = q.array(
'combusken' + t.constants,
'pignite' + t.constants,
'slugma' + t.constants,
'raboot' + t.constants,
'numel' + t.constants,
'houndour' + t.constants,
'salandit' + t.constants,
'sizzlipede' + t.constants,
'fletchinder' + t.constants,
'darumaka' + t.constants,
'vulpix' + t.constants,
'growlithe' + t.constants,
'ponyta' + t.constants,
'magby' + t.constants,
'charmeleon' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'MEDIUM' ? {
t.mons = q.array(
'blaziken' + t.constants,
'emboar' + t.constants,
'magcargo' + t.constants,
'cinderace' + t.constants,
'camerupt' + t.constants,
'houndoom' + t.constants,
'magmar' + t.constants,
'turtonator' + t.constants,
'talonflame' + t.constants,
'scovillain' + t.constants,
'ninetales' + t.constants,
'heatmor' + t.constants,
'rapidash' + t.constants,
'torkoal' + t.constants,
'tauros bull_breed=blaze' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'HARD' ? {
t.mons = q.array(
'blaziken' + t.constants,
'emboar' + t.constants,
'magcargo' + t.constants,
'cinderace' + t.constants,
'camerupt' + t.constants,
'houndoom' + t.constants,
'magmortar' + t.constants,
'turtonator' + t.constants,
'talonflame' + t.constants,
'scovillain' + t.constants,
'ninetales' + t.constants,
'heatmor' + t.constants,
'rapidash' + t.constants,
'torkoal' + t.constants,
'tauros bull_breed=blaze' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};
return 0;