t.constants = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry level=' + (q.player.party.highest_level - 2);
t.constants_hard = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry hp_ev=80 attack_ev=80 defence_ev=80 special_attack_ev=80 special_defence_ev=80 speed_ev=80 level=' + (q.player.party.highest_level - 2);

t.data = q.run_script('cobblemon:gs_gym_leader_difficulty');

t.data == 'EASY' ? {
t.mons = q.array(
'clefairy' + t.constants,
'floette' + t.constants,
'snubbull' + t.constants,
'spritzee' + t.constants,
'swirlix' + t.constants,
'ponyta galarian' + t.constants,
'cottonee' + t.constants,
'cutiefly' + t.constants,
'morelull' + t.constants,
'jigglypuff' + t.constants,
'dedenne' + t.constants,
'carbink' + t.constants,
'togetic' + t.constants,
'mawile' + t.constants,
'kirlia' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'MEDIUM' ? {
t.mons = q.array(
'clefable' + t.constants,
'florges' + t.constants,
'granbull' + t.constants,
'aromatisse' + t.constants,
'slurpuff' + t.constants,
'rapidash galarian' + t.constants,
'whimsicott' + t.constants,
'ribombee' + t.constants,
'shiinotic' + t.constants,
'comfey' + t.constants,
'azurill' + t.constants,
'carbink' + t.constants,
'togekiss' + t.constants,
'ninetales alolan' + t.constants,
'gardevoir' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'HARD' ? {
t.mons = q.array(
'clefable' + t.constants,
'florges' + t.constants,
'snubbull' + t.constants,
'spritzee' + t.constants,
'swirlix' + t.constants,
'ponyta galarian' + t.constants,
'cottonee' + t.constants,
'cutiefly' + t.constants,
'morelull' + t.constants,
'comfey' + t.constants,
'azurill' + t.constants,
'hatterene' + t.constants,
'togekiss' + t.constants,
'ninetales alolan' + t.constants,
'gardevoir' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};
return 0;