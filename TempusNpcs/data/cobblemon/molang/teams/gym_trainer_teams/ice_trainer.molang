t.constants = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry level=' + (q.player.party.highest_level - 2);
t.constants_hard = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry hp_ev=80 attack_ev=80 defence_ev=80 special_attack_ev=80 special_defence_ev=80 speed_ev=80 level=' + (q.player.party.highest_level - 2);

t.data = q.run_script('cobblemon:gs_gym_leader_difficulty');

t.data == 'EASY' ? {
t.mons = q.array(
'cetoddle' + t.constants,
'bergmite' + t.constants,
'vulpix alolan' + t.constants,
'snorunt' + t.constants,
'swinub' + t.constants,
'delibird' + t.constants,
'spheal' + t.constants,
'cubchoo' + t.constants,
'sneasel' + t.constants,
'eiscue' + t.constants,
'smoochum' + t.constants,
'snom' + t.constants,
'snover' + t.constants,
'frigibax' + t.constants,
'vanillite' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'MEDIUM' ? {
t.mons = q.array(
'cetitan' + t.constants,
'avalugg' + t.constants,
'ninetales alolan' + t.constants,
'glalie' + t.constants,
'piloswine' + t.constants,
'delibird' + t.constants,
'sealeo' + t.constants,
'beartic' + t.constants,
'weavile' + t.constants,
'eiscue' + t.constants,
'jynx' + t.constants,
'lapras' + t.constants,
'cryogonal' + t.constants,
'froslass' + t.constants,
'vanillish' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'HARD' ? {
t.mons = q.array(
'cetitan' + t.constants,
'avalugg' + t.constants,
'ninetales alolan' + t.constants,
'glalie' + t.constants,
'mamoswine' + t.constants,
'delibird' + t.constants,
'walrein' + t.constants,
'beartic' + t.constants,
'weavile' + t.constants,
'eiscue' + t.constants,
'jynx' + t.constants,
'lapras' + t.constants,
'cryogonal' + t.constants,
'froslass' + t.constants,
'vanilluxe' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};
return 0;