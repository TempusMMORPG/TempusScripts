t.constants = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry level=' + (q.player.party.highest_level - 2);
t.constants_hard = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry hp_ev=80 attack_ev=80 defence_ev=80 special_attack_ev=80 special_defence_ev=80 speed_ev=80 level=' + (q.player.party.highest_level - 2);

t.data = q.run_script('cobblemon:gs_gym_leader_difficulty');

t.data == 'EASY' ? {
t.mons = q.array(
'meowth' + t.constants,
'ditto' + t.constants,
'porygon' + t.constants,
'slakoth' + t.constants,
'munchlax' + t.constants,
'minccino' + t.constants,
'wooloo' + t.constants,
'tandemaus' + t.constants,
'jigglypuff' + t.constants,
'stufful' + t.constants,
'litleo' + t.constants,
'helioptile' + t.constants,
'zigzagoon' + t.constants,
'glameow' + t.constants,
'teddiursa' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'MEDIUM' ? {
t.mons = q.array(
'persian' + t.constants,
'ditto' + t.constants,
'porygon2' + t.constants,
'vigoroth' + t.constants,
'snorlax' + t.constants,
'cinccino' + t.constants,
'dubwool' + t.constants,
'maushold' + t.constants,
'wigglytuff' + t.constants,
'bewear' + t.constants,
'komala' + t.constants,
'drampa' + t.constants,
'stantler' + t.constants,
'purugly' + t.constants,
'ursaring' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'HARD' ? {
t.mons = q.array(
'persian' + t.constants,
'ditto' + t.constants,
'porygon2' + t.constants,
'slaking' + t.constants,
'snorlax' + t.constants,
'cinccino' + t.constants,
'dubwool' + t.constants,
'maushold' + t.constants,
'wigglytuff' + t.constants,
'bewear' + t.constants,
'komala' + t.constants,
'drampa' + t.constants,
'wyrdeer' + t.constants,
'purugly' + t.constants,
'ursaluna' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};
return 0;