t.constants = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry level=' + (q.player.party.highest_level - 2);
t.constants_hard = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry hp_ev=80 attack_ev=80 defence_ev=80 special_attack_ev=80 special_defence_ev=80 speed_ev=80 level=' + (q.player.party.highest_level - 2);

t.data = q.run_script('cobblemon:gs_gym_leader_difficulty');

t.data == 'EASY' ? {
t.mons = q.array(
'meowth galarian' + t.constants,
'klink' + t.constants,
'cufant' + t.constants,
'mawile' + t.constants,
'aron' + t.constants,
'stunfisk galarian' + t.constants,
'bronzor' + t.constants,
'honedge' + t.constants,
'pawniard' + t.constants,
'varoom' + t.constants,
'magnemite' + t.constants,
'togedemaru' + t.constants,
'tinkatink' + t.constants,
'shieldon' + t.constants,
'ferroseed' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'MEDIUM' ? {
t.mons = q.array(
'perrserker' + t.constants,
'klang' + t.constants,
'copperajah' + t.constants,
'scizor' + t.constants,
'lairon' + t.constants,
'steelix' + t.constants,
'bronzong' + t.constants,
'doublade' + t.constants,
'bisharp' + t.constants,
'empoleon' + t.constants,
'excadrill' + t.constants,
'togedemaru' + t.constants,
'tinkatuff' + t.constants,
'bastiodon' + t.constants,
'ferrothorn' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'HARD' ? {
t.mons = q.array(
'perrserker' + t.constants,
'klinklang' + t.constants,
'copperajah' + t.constants,
'scizor' + t.constants,
'aggron' + t.constants,
'steelix' + t.constants,
'bronzong' + t.constants,
'aegislash' + t.constants,
'bisharp' + t.constants,
'empoleon' + t.constants,
'excadrill' + t.constants,
'togedemaru' + t.constants,
'tinkaton' + t.constants,
'bastiodon' + t.constants,
'ferrothorn' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};
return 0;