t.constants = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry level=' + (q.player.party.highest_level - 2);
t.constants_hard = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry hp_ev=80 attack_ev=80 defence_ev=80 special_attack_ev=80 special_defence_ev=80 speed_ev=80 level=' + (q.player.party.highest_level - 2);

t.data = q.run_script('cobblemon:gs_gym_leader_difficulty');

t.data == 'EASY' ? {
t.mons = q.array(
'finneon' + t.constants,
'tentacool' + t.constants,
'mantyke' + t.constants,
'psyduck' + t.constants,
'shellos' + t.constants,
'krabby' + t.constants,
'lotad' + t.constants,
'remoraid' + t.constants,
'carvanha' + t.constants,
'frillish' + t.constants,
'ducklett' + t.constants,
'clauncher' + t.constants,
'pyukumuku' + t.constants,
'arrokuda' + t.constants,
'wiglett' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'MEDIUM' ? {
t.mons = q.array(
'lumineon' + t.constants,
'tentacruel' + t.constants,
'mantine' + t.constants,
'golduck' + t.constants,
'gastrodon' + t.constants,
'kingler' + t.constants,
'lombre' + t.constants,
'octillery' + t.constants,
'sharpedo' + t.constants,
'jellicent' + t.constants,
'swanna' + t.constants,
'clawitzer' + t.constants,
'pyukumuku' + t.constants,
'barraskewda' + t.constants,
'wugtrio' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'HARD' ? {
t.mons = q.array(
'lumineon' + t.constants_hard,
'tentacruel' + t.constants_hard,
'mantine' + t.constants_hard,
'golduck' + t.constants_hard,
'gastrodon' + t.constants_hard,
'kingler' + t.constants_hard,
'ludicolo' + t.constants_hard,
'octillery' + t.constants_hard,
'sharpedo' + t.constants_hard,
'jellicent' + t.constants_hard,
'swanna' + t.constants_hard,
'clawitzer' + t.constants_hard,
'pyukumuku' + t.constants_hard,
'barraskewda' + t.constants_hard,
'wugtrio' + t.constants_hard
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};
return 0;