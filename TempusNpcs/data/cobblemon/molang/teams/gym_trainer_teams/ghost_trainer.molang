t.constants = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry level=' + (q.player.party.highest_level - 2);
t.constants_hard = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry hp_ev=80 attack_ev=80 defence_ev=80 special_attack_ev=80 special_defence_ev=80 speed_ev=80 level=' + (q.player.party.highest_level - 2);

t.data = q.run_script('cobblemon:gs_gym_leader_difficulty');

t.data == 'EASY' ? {
t.mons = q.array(
'misdreavus' + t.constants,
'shuppet' + t.constants,
'sinistea' + t.constants,
'litwick' + t.constants,
'sableye' + t.constants,
'frillish' + t.constants,
'poltchageist' + t.constants,
'honedge' + t.constants,
'zorua hisuian' + t.constants,
'rotom' + t.constants,
'drifloon' + t.constants,
'gastly' + t.constants,
'duskull' + t.constants,
'golett' + t.constants,
'dreepy' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'MEDIUM' ? {
t.mons = q.array(
'mismagius' + t.constants,
'banette' + t.constants,
'polteageist' + t.constants,
'lampent' + t.constants,
'sableye' + t.constants,
'jellicent' + t.constants,
'sinistcha' + t.constants,
'doublade' + t.constants,
'zoroark hisuian' + t.constants,
'rotom' + t.constants,
'drifblim' + t.constants,
'froslass' + t.constants,
'typhlosion hisuian' + t.constants,
'skeledirge' + t.constants,
'mimikyu' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'HARD' ? {
t.mons = q.array(
'mismagius' + t.constants,
'banette' + t.constants,
'polteageist' + t.constants,
'chandelure' + t.constants,
'sableye' + t.constants,
'jellicent' + t.constants,
'sinistcha' + t.constants,
'aegislash' + t.constants,
'zoroark hisuian' + t.constants,
'rotom' + t.constants,
'drifblim' + t.constants,
'froslass' + t.constants,
'typhlosion hisuian' + t.constants,
'skeledirge' + t.constants,
'mimikyu' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};
return 0;