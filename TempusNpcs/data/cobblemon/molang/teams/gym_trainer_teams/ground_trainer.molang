t.constants = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry level=' + (q.player.party.highest_level - 2);
t.constants_hard = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry hp_ev=80 attack_ev=80 defence_ev=80 special_attack_ev=80 special_defence_ev=80 speed_ev=80 level=' + (q.player.party.highest_level - 2);

t.data = q.run_script('cobblemon:gs_gym_leader_difficulty');

t.data == 'EASY' ? {
t.mons = q.array(
'sandshrew' + t.constants,
'cubone' + t.constants,
'diglett' + t.constants,
'drilbur' + t.constants,
'rhyhorn' + t.constants,
'mudbray' + t.constants,
'baltoy' + t.constants,
'golett' + t.constants,
'onix' + t.constants,
'geodude' + t.constants,
'toedscool' + t.constants,
'swinub' + t.constants,
'silicobra' + t.constants,
'phanpy' + t.constants,
'trapinch' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'MEDIUM' ? {
t.mons = q.array(
'sandslash' + t.constants,
'marowak' + t.constants,
'dugtrio' + t.constants,
'excadrill' + t.constants,
'rhydon' + t.constants,
'mudsdale' + t.constants,
'claydol' + t.constants,
'golett' + t.constants,
'steelix' + t.constants,
'graveler' + t.constants,
'toedscruel' + t.constants,
'gastrodon' + t.constants,
'sandaconda' + t.constants,
'donphan' + t.constants,
'diggersby' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'HARD' ? {
t.mons = q.array(
'sandslash' + t.constants,
'marowak' + t.constants,
'dugtrio' + t.constants,
'excadrill' + t.constants,
'rhyperior' + t.constants,
'mudsdale' + t.constants,
'claydol' + t.constants,
'golurk' + t.constants,
'steelix' + t.constants,
'golem' + t.constants,
'toedscruel' + t.constants,
'gastrodon' + t.constants,
'sandaconda' + t.constants,
'donphan' + t.constants,
'diggersby' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};
return 0;