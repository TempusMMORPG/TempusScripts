t.constants = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry level=' + (q.player.party.highest_level - 2);
t.constants_hard = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry hp_ev=80 attack_ev=80 defence_ev=80 special_attack_ev=80 special_defence_ev=80 speed_ev=80 level=' + (q.player.party.highest_level - 2);

t.data = q.run_script('cobblemon:gs_gym_leader_difficulty');

t.data == 'EASY' ? {
t.mons = q.array(
'carkol' + t.constants,
'geodude' + t.constants,
'roggenrola' + t.constants,
'nacli' + t.constants,
'carbink' + t.constants,
'glimmet' + t.constants,
'aron' + t.constants,
'omanyte' + t.constants,
'kabuto' + t.constants,
'lileep' + t.constants,
'anorith' + t.constants,
'shieldon' + t.constants,
'cranidos' + t.constants,
'nosepass' + t.constants,
'dwebble' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'MEDIUM' ? {
t.mons = q.array(
'coalossal' + t.constants,
'graveler' + t.constants,
'boldore' + t.constants,
'naclstack' + t.constants,
'carbink' + t.constants,
'glimmora' + t.constants,
'lairon' + t.constants,
'omastar' + t.constants,
'kabutops' + t.constants,
'cradily' + t.constants,
'armaldo' + t.constants,
'bastiodon' + t.constants,
'rampardos' + t.constants,
'probopass' + t.constants,
'crustle' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'HARD' ? {
t.mons = q.array(
'coalossal' + t.constants_hard,
'golem' + t.constants_hard,
'gigalith' + t.constants_hard,
'garganacl' + t.constants_hard,
'carbink' + t.constants_hard,
'glimmora' + t.constants_hard,
'aggron' + t.constants_hard,
'omastar' + t.constants_hard,
'kabutops' + t.constants_hard,
'cradily' + t.constants_hard,
'armaldo' + t.constants_hard,
'bastiodon' + t.constants_hard,
'rampardos' + t.constants_hard,
'probopass' + t.constants_hard,
'crustle' + t.constants_hard
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};
return 0;