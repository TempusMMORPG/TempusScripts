t.constants = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry level=' + (q.player.party.highest_level - 2);
t.constants_hard = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry hp_ev=80 attack_ev=80 defence_ev=80 special_attack_ev=80 special_defence_ev=80 speed_ev=80 level=' + (q.player.party.highest_level - 2);

t.data = q.run_script('cobblemon:gs_gym_leader_difficulty');

t.data == 'EASY' ? {
t.mons = q.array(
'corvisquire' + t.constants,
'pidgeotto' + t.constants,
'noctowl' + t.constants,
'murkrow' + t.constants,
'skiploom' + t.constants,
'taillow' + t.constants,
'swablu' + t.constants,
'staravia' + t.constants,
'drifloon' + t.constants,
'tranquill' + t.constants,
'emolga' + t.constants,
'rufflet' + t.constants,
'wattrel' + t.constants,
'fletchinder' + t.constants,
'wingull' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'MEDIUM' ? {
t.mons = q.array(
'corviknight' + t.constants,
'pidgeot' + t.constants,
'noctowl' + t.constants,
'aerodactyl' + t.constants,
'jumpluff' + t.constants,
'swellow' + t.constants,
'altaria' + t.constants,
'staraptor' + t.constants,
'drifblim' + t.constants,
'unfezant' + t.constants,
'emolga' + t.constants,
'rufflet' + t.constants,
'kilowattrel' + t.constants,
'talonflame' + t.constants,
'pelipper' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'HARD' ? {
t.mons = q.array(
'corviknight' + t.constants,
'pidgeot' + t.constants,
'braviary' + t.constants,
'aerodactyl' + t.constants,
'jumpluff' + t.constants,
'swellow' + t.constants,
'altaria' + t.constants,
'staraptor' + t.constants,
'drifblim' + t.constants,
'unfezant' + t.constants,
'emolga' + t.constants,
'dragonite' + t.constants,
'kilowattrel' + t.constants,
'talonflame' + t.constants,
'pelipper' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};
return 0;