t.constants = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry level=' + (q.player.party.highest_level - 2);
t.constants_hard = ' hp_iv=31 attack_iv=31 defence_iv=31 special_attack_iv=31 special_defence_iv=31 speed_iv=31 uncatchable=true held_item=cobblemon:sitrus_berry hp_ev=80 attack_ev=80 defence_ev=80 special_attack_ev=80 special_defence_ev=80 speed_ev=80 level=' + (q.player.party.highest_level - 2);

t.data = q.run_script('cobblemon:gs_gym_leader_difficulty');

t.data == 'EASY' ? {
t.mons = q.array(
'kadabra' + t.constants,
'solosis' + t.constants,
'elgyem' + t.constants,
'woobat' + t.constants,
'slowpoke' + t.constants,
'girafarig' + t.constants,
'baltoy' + t.constants,
'beldum' + t.constants,
'bronzor' + t.constants,
'inkay' + t.constants,
'dottler' + t.constants,
'flittle' + t.constants,
'natu' + t.constants,
'mimejr' + t.constants,
'meditite' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'MEDIUM' ? {
t.mons = q.array(
'kadabra' + t.constants,
'duosion' + t.constants,
'beheeyem' + t.constants,
'swoobat' + t.constants,
'indeedee' + t.constants,
'farigiraf' + t.constants,
'claydol' + t.constants,
'metang' + t.constants,
'bronzong' + t.constants,
'malamar' + t.constants,
'orbeetle' + t.constants,
'starmie' + t.constants,
'solrock' + t.constants,
'lunatone' + t.constants,
'sigilyph' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};

t.data == 'HARD' ? {
t.mons = q.array(
'alakazam' + t.constants,
'reuniclus' + t.constants,
'beheeyem' + t.constants,
'swoobat' + t.constants,
'indeedee' + t.constants,
'farigiraf' + t.constants,
'claydol' + t.constants,
'metagross' + t.constants,
'bronzong' + t.constants,
'malamar' + t.constants,
'orbeetle' + t.constants,
'starmie' + t.constants,
'solrock' + t.constants,
'lunatone' + t.constants,
'sigilyph' + t.constants
);
t.mons_length = q.length(t.mons);

loop(3, {
t.index = math.random_integer(0, t.mons_length);
q.party.add_by_properties(t.mons[t.index]);
});
return 1;
};
return 0;