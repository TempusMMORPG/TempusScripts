t.roll = math.random_integer(1, 100);

t.roll <= 15 && t.roll >= 1 ? {
    q.run_command('give ' + q.player.username + ' cobblemon:white_apricorn 3');
    q.player.tell('§aYou have harvested the Apricorn Tree! You found §d3x White Apricorns§a!');
    return 1;
};

t.roll <= 45 && t.roll > 15 ? {
    q.run_command('give ' + q.player.username + ' cobblemon:white_apricorn 1');
    q.player.tell('§aYou have harvested the Apricorn Tree! You found §d1x White Apricorn§a!');
    return 1;
};

t.roll <= 60 && t.roll > 45 ? {
    q.run_command('give ' + q.player.username + ' cobblemon:white_apricorn 2');
    q.player.tell('§aYou have harvested the Apricorn Tree! You found §d2x White Apricorns§a!');
    return 1;
};

t.roll <= 65 && t.roll > 60 ? {
    q.run_command('give ' + q.player.username + ' cobblemon:white_apricorn 5');
    q.player.tell('§aYou have harvested the Apricorn Tree! You found §d5x White Apricorns§a!');
    return 1;
};

t.pokelevel1 = math.random_integer(5, 10);
t.pokelevel2 = math.random_integer(8, 12);
t.pokelevel3 = math.random_integer(5, 10);

t.roll <= 85 && t.roll > 65 ? {
    q.run_command('pokespawnat ' + q.player.x + ' ' + q.player.y + ' ' + q.player.z + ' smoliv lvl=' + t.pokelevel1);
    q.player.tell('§aYou have harvested the Apricorn Tree! A wild §dSmoliv§a appeared!');
    return 1;
};

t.roll <= 95 && t.roll > 85 ? {
    q.run_command('pokespawnat ' + q.player.x + ' ' + q.player.y + ' ' + q.player.z + ' seedot lvl=' + t.pokelevel1);
    q.player.tell('§aYou have harvested the Apricorn Tree! A wild §dSeedot§a appeared!');
    return 1;
};

t.roll <= 99 && t.roll > 95 ? {
    q.player.tell('§cYou found nothing!');
    return 1;
};

t.roll == 100 ? {
    q.run_command('pokespawnat ' + q.player.x + ' ' + q.player.y + ' ' + q.player.z + ' applin lvl=' + t.pokelevel3);
    q.player.tell('§aYou have harvested the Apricorn Tree! A wild §dApplin§a appeared!');
    return 1;
};

return 0;