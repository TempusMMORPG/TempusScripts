t.roll = math.random_integer(1, 100);

t.roll <= 15 && t.roll >= 1 ? {
    q.run_command('give ' + q.player.username + ' cobblemon:relic_coin 3');
    q.player.tell('§aYou have opened the chest! You found §d3x Relic Coins§a!');
    return 1;
};

t.roll <= 45 && t.roll > 15 ? {
    q.run_command('give ' + q.player.username + ' cobblemon:relic_coin 1');
    q.player.tell('§aYou have opened the chest! You found §d1x Relic Coin§a!');
    return 1;
};

t.roll <= 60 && t.roll > 45 ? {
    q.run_command('give ' + q.player.username + ' cobblemon:relic_coin 2');
    q.player.tell('§aYou have opened the chest! You found §d2x Relic Coins§a!');
    return 1;
};

t.roll <= 65 && t.roll > 60 ? {
    q.run_command('give ' + q.player.username + ' cobblemon:relic_coin 5');
    q.player.tell('§aYou have opened the chest! You found §d5x Relic Coins§a!');
    return 1;
};

t.pokelevel1 = math.random_integer(5, 10);
t.pokelevel2 = math.random_integer(8, 12);
t.pokelevel3 = math.random_integer(5, 10);

t.roll <= 85 && t.roll > 65 ? {
    q.run_command('pokespawnat ' + q.player.x + ' ' + q.player.y + ' ' + q.player.z + ' meowth lvl=' + t.pokelevel1);
    q.player.tell('§aYou have opened the chest! A wild §dMeowth§a appeared!');
    return 1;
};

t.roll <= 95 && t.roll > 85 ? {
    q.run_command('give ' + q.player.username + ' cobblemon:relic_coin 2');
    q.player.tell('§aYou have opened the chest! You found §d2x Relic Coins§a!');
    return 1;
};

t.roll <= 99 && t.roll > 95 ? {
    q.player.tell('§cYou found nothing!');
    return 1;
};

t.roll == 100 ? {
    q.run_command('pokespawnat ' + q.player.x + ' ' + q.player.y + ' ' + q.player.z + ' gimmighoul lvl=' + t.pokelevel3);
    q.player.tell('§aYou have opened the chest! A wild §dGimmighoul§a appeared!');
    return 1;
};

return 0;