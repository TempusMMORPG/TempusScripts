'Give the pokemon to the player if their data matches and party is empty.';
q.player.party.count == 0  && q.player.data.dialogue.starter_selected == 0 ? {
    q.player.tell('§a§l[✔] ' + q.npc.config.starter_name_display + '§a§l was added to your party [✔]§r');
    q.run_command('pokegiveother ' + q.player.username + ' ' + q.npc.config.starter_name + ' lvl=5');
} : {
    q.player.tell('§c§lYou have already selected a starter');}