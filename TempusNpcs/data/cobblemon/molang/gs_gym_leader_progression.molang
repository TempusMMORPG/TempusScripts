'Executes when a gym leader is defeated';

t.stage = q.player.data.gym_stage;

t.stage >= 18 ? {
    t.stage = 18;
} : {
    t.stage = t.stage + 1;
};

q.player.data.gym_stage = t.stage;
q.run_command('lp user ' + c.player.username + ' meta set tempus.gymbadge.count ' + q.player.data.gym_stage);
q.player.save_data();