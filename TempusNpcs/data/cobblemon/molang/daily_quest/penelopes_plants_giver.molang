t.current_time = q.system_time_millis;
t.player_cooldown_time = q.player.get_npc_variable(q.npc.uuid, 'cooldown_time');

t.current_time < t.player_cooldown_time ? {
    t.remaining_time = t.player_cooldown_time - t.current_time;
    t.hours = math.floor(t.remaining_time / 3600000);
    t.minutes = math.floor(math.mod(t.remaining_time, 3600000) / 60000);
    t.seconds = math.floor(math.mod(t.remaining_time, 60000) / 1000);
    
    q.player.tell('§cYou have completed this quest already! Come back in: ' + t.hours + 'h ' + t.minutes + 'm ' + t.seconds + 's');
    return 0;
};

t.quest_item_pool = q.array(
    'minecraft:dark_oak_sapling', 'minecraft:sunflower', 'minecraft:lily_pad', 'cobblemon:aspear_berry', 
    'cobblemon:pecha_berry', 'cobblemon:babiri_berry', 'cobblemon:big_root', 'cobblemon:bluk_berry', 
    'cobblemon:charti_berry', 'cobblemon:chesto_berry', 'cobblemon:cheri_berry', 'cobblemon:chilan_berry', 
    'cobblemon:chople_berry', 'cobblemon:coba_berry', 'cobblemon:colbur_berry', 'cobblemon:kasib_berry', 
    'cobblemon:kebia_berry', 'cobblemon:nanab_berry', 'cobblemon:occa_berry', 'cobblemon:oran_berry', 
    'cobblemon:passho_berry', 'cobblemon:payapa_berry', 'cobblemon:persim_berry', 'cobblemon:pomeg_berry', 
    'cobblemon:pecha_berry', 'cobblemon:haban_berry', 'cobblemon:pinap_berry', 'cobblemon:rawst_berry', 
    'cobblemon:razz_berry', 'cobblemon:sitrus_berry', 'cobblemon:rindo_berry', 'cobblemon:shuca_berry', 
    'cobblemon:tanga_berry', 'cobblemon:wacan_berry', 'cobblemon:wepear_berry', 'cobblemon:yuca_berry'
);

t.array_size = 36;
t.index = math.random_integer(0, t.array_size - 1);
t.amount = math.random_integer(2, 8);

t.item_id = t.quest_item_pool[t.index];
t.item_string_array = q.split_string(t.item_id, ':');
t.item_name = t.item_string_array[1];

q.player.set_npc_variable(q.npc.uuid, 'quest_item_id', t.item_id);
q.player.set_npc_variable(q.npc.uuid, 'quest_item_amount', t.amount);

return t.amount + ' ' + t.item_name;